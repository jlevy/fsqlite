{
  "name": "fsqlite-workspace",
  "private": true,
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=22.18.0 <23 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm --filter fsqlite build",
    "format": "pnpm format:code && pnpm format:markdown",
    "format:check": "pnpm format:code:check && pnpm format:markdown:check",
    "format:code": "prettier --write .",
    "format:code:check": "prettier --check .",
    "format:markdown": "uvx --isolated --no-build --from flowmark-rs==0.4.0 flowmark --auto --inplace --nobackup .",
    "format:markdown:check": "uvx --isolated --no-build --from flowmark-rs==0.4.0 flowmark --auto --check .",
    "typecheck": "pnpm --filter fsqlite typecheck",
    "lint": "pnpm --filter fsqlite lint",
    "lint:check": "pnpm --filter fsqlite lint:check",
    "test": "pnpm --filter fsqlite test",
    "check:docs": "pnpm --filter fsqlite check:docs",
    "test:golden": "pnpm --filter fsqlite test:golden",
    "test:project-hooks": "node scripts/check-project-hooks.mjs",
    "test:supply-chain": "node --test scripts/supply-chain-exceptions.test.mjs && node scripts/check-supply-chain.mjs",
    "test:package": "pnpm --filter fsqlite test:package",
    "test:all": "pnpm --filter fsqlite test:all",
    "verify": "pnpm format:check && pnpm lint:check && pnpm typecheck && pnpm test:project-hooks && pnpm test:supply-chain && pnpm test:all"
  },
  "devDependencies": {
    "lefthook": "2.2.1",
    "prettier": "3.9.10"
  }
}
