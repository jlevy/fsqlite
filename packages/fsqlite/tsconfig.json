{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    // Source uses explicit `.ts` import specifiers so Node's native type-stripping can
    // resolve them at runtime (`node src/cli/bin.ts`); tsc needs this to allow them.
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "erasableSyntaxOnly": true,
    // The published declarations omit members marked @internal, such as the store layout
    // paths, which tests and the CLI use but callers should not depend on.
    "stripInternal": true,
    "types": ["node"]
  },
  "include": ["src", "test", "workers", "examples", "benchmarks", "scripts", "tsdown.config.ts"]
}
