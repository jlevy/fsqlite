diff -ruN a/packages/fsqlite/src/derived.ts b/packages/fsqlite/src/derived.ts
--- a/packages/fsqlite/src/derived.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/packages/fsqlite/src/derived.ts	2026-11-17 04:53:43.028745126 +0000
@@ -0,0 +1,739 @@
+// derived.ts: PROTOTYPE (fsqlite v2, Spike 1). Derived objects built inside each generation.
+//
+// With `StoreOptions.derived`, the caller schema splits in two. Base tables (the `schema`
+// DDL) have primary keys, travel in changesets, and follow the conflict policy. Derived
+// objects (secondary indexes, FTS5 and other virtual tables, summary tables, and
+// `sqlite_stat1`) are computed from them by a declared, versioned hook that runs inside
+// every generation build, after the envelopes or the direct callback and before the gate.
+// Closure relations run first, removing child rows whose parent the build deleted.
+//
+// Every generation stamps `base_tables`, `derived_version`, and `derived_hash` in
+// `fsqlite_meta`. A build refuses a store stamped with a newer derived version, or with
+// the same version and a different hash, and upgrades a store stamped with an older one in
+// place (same store_id).
+
+import { createHash } from 'node:crypto'
+import { DatabaseSync } from 'node:sqlite'
+import { FsqliteError } from './errors.ts'
+import { OWNED_TABLES, foreignKeyCheck, quickCheck } from './driver.ts'
+import type {
+  BuildInfo,
+  ChangedKeys,
+  ChangedRow,
+  DerivedSpec,
+  PlanAssertion,
+  Relation,
+} from './types.ts'
+
+const now = (): number => Number(process.hrtime.bigint()) / 1e6
+const ms = (t: number): number => Math.round((now() - t) * 1000) / 1000
+const quote = (name: string): string => `"${name.replace(/"/g, '""')}"`
+const OWNED: ReadonlySet<string> = new Set(OWNED_TABLES)
+
+/** The base schema's objects and primary keys, from running its DDL in memory. */
+export interface BaseInfo {
+  tables: string[]
+  tableSet: ReadonlySet<string>
+  objects: ReadonlySet<string>
+  /** Primary-key columns per base table, in column order (the changeset's key order). */
+  pk: ReadonlyMap<string, string[]>
+  fingerprint: string
+}
+
+interface SchemaObject {
+  type: string
+  name: string
+  tbl_name: string
+  sql: string | null
+}
+
+/** The resolved derived configuration a store handle builds with. */
+export interface DerivedContext {
+  spec: DerivedSpec
+  relations: Relation[]
+  base: BaseInfo
+  hash: string
+  /** The derived objects `spec.ddl` creates over the base schema, in creation order. */
+  desired: SchemaObject[]
+  analysisLimit: number
+  rebuildAboveRatio: number
+}
+
+function listObjects(db: DatabaseSync): SchemaObject[] {
+  return db
+    .prepare(
+      "SELECT type, name, tbl_name, sql FROM main.sqlite_schema WHERE name NOT LIKE 'sqlite_%' ORDER BY rowid",
+    )
+    .all() as unknown as SchemaObject[]
+}
+
+function shadowTables(db: DatabaseSync): Set<string> {
+  return new Set(
+    (
+      db.prepare('PRAGMA main.table_list').all() as {
+        name: string
+        type: string
+      }[]
+    )
+      .filter((t) => t.type === 'shadow')
+      .map((t) => t.name),
+  )
+}
+
+/** Base table names and their primary keys, read from `db`. */
+function describeBase(db: DatabaseSync, objects: SchemaObject[]): BaseInfo {
+  const tables = objects.filter((o) => o.type === 'table' && !OWNED.has(o.name)).map((o) => o.name)
+  const pk = new Map<string, string[]>()
+  for (const t of tables) {
+    const cols = db.prepare(`PRAGMA table_info(${quote(t)})`).all() as {
+      cid: number
+      name: string
+      pk: number
+    }[]
+    pk.set(
+      t,
+      cols
+        .filter((c) => c.pk > 0)
+        .sort((a, b) => a.cid - b.cid)
+        .map((c) => c.name),
+    )
+  }
+  const names = objects.filter((o) => !OWNED.has(o.name)).map((o) => o.name)
+  return {
+    tables,
+    tableSet: new Set(tables),
+    objects: new Set(names),
+    pk,
+    fingerprint: JSON.stringify(objects.filter((o) => !OWNED.has(o.name))),
+  }
+}
+
+/** The derived objects in `db`: not base, not owned, not internal, not shadow tables. */
+export function derivedObjects(db: DatabaseSync, base: BaseInfo): SchemaObject[] {
+  const shadow = shadowTables(db)
+  return listObjects(db).filter(
+    (o) => !base.objects.has(o.name) && !OWNED.has(o.name) && !shadow.has(o.name),
+  )
+}
+
+function baseFingerprint(db: DatabaseSync, base: BaseInfo): string {
+  return JSON.stringify(listObjects(db).filter((o) => base.objects.has(o.name)))
+}
+
+export function derivedHash(spec: DerivedSpec, relations: Relation[]): string {
+  return createHash('sha256')
+    .update(
+      JSON.stringify({
+        version: spec.version,
+        ddl: spec.ddl,
+        statistics: spec.statistics ?? 'optimize',
+        analysisLimit: spec.analysisLimit ?? 0,
+        relations,
+      }),
+    )
+    .digest('hex')
+    .slice(0, 16)
+}
+
+/** Validate the options and resolve the context a handle builds with. */
+export function resolveDerived(
+  schema: string,
+  spec: DerivedSpec | undefined,
+  relations: Relation[] | undefined,
+): DerivedContext | null {
+  if (spec === undefined) {
+    if (relations !== undefined && relations.length > 0) {
+      throw new TypeError('relations require a derived specification')
+    }
+    return null
+  }
+  if (!Number.isSafeInteger(spec.version) || spec.version < 0) {
+    throw new TypeError(
+      `derived.version must be a safe integer >= 0; received ${String(spec.version)}`,
+    )
+  }
+  if (typeof spec.ddl !== 'string' || typeof spec.rebuild !== 'function') {
+    throw new TypeError('derived needs a ddl string and a rebuild function')
+  }
+  const db = new DatabaseSync(':memory:')
+  let base: BaseInfo
+  let desired: SchemaObject[]
+  try {
+    db.exec(schema)
+    base = describeBase(db, listObjects(db))
+    db.exec(spec.ddl)
+    if (baseFingerprint(db, base) !== base.fingerprint) {
+      throw new TypeError('derived.ddl must not change base tables')
+    }
+    desired = derivedObjects(db, base)
+  } finally {
+    db.close()
+  }
+  const triggers = desired.filter((o) => o.type === 'trigger').map((o) => o.name)
+  if (triggers.length > 0) {
+    throw new TypeError(`derived.ddl must not declare triggers: ${triggers.join(', ')}`)
+  }
+  const rels = relations ?? []
+  for (const r of rels) {
+    const parentPk = base.pk.get(r.parent)
+    const childPk = base.pk.get(r.child)
+    if (!parentPk || !childPk) {
+      throw new TypeError(`relation ${r.child} -> ${r.parent}: both must be base tables`)
+    }
+    const parentCols = r.parentColumns ?? parentPk
+    if (JSON.stringify(parentCols) !== JSON.stringify(parentPk)) {
+      throw new TypeError(
+        `relation ${r.child} -> ${r.parent}: parentColumns must be the parent's primary key`,
+      )
+    }
+    if (r.columns.length !== parentCols.length || (r.onMissing as string) !== 'delete') {
+      throw new TypeError(
+        `relation ${r.child} -> ${r.parent}: columns must match the parent key; onMissing must be 'delete'`,
+      )
+    }
+  }
+  return {
+    spec,
+    relations: rels,
+    base,
+    hash: derivedHash(spec, rels),
+    desired,
+    analysisLimit: spec.analysisLimit ?? 0,
+    rebuildAboveRatio: spec.rebuildAboveRatio ?? 0.5,
+  }
+}
+
+function meta(db: DatabaseSync, key: string): string | undefined {
+  return (
+    db.prepare('SELECT value FROM fsqlite_meta WHERE key = ?').get(key) as
+      { value: string } | undefined
+  )?.value
+}
+
+/**
+ * Whether a build of `db` may proceed under `ctx`: `current` when the stamp matches,
+ * `upgrade` when the store carries no stamp or an older version. Throws on a newer version
+ * or a same-version hash mismatch.
+ */
+export function assertBuildable(db: DatabaseSync, ctx: DerivedContext): 'current' | 'upgrade' {
+  const version = meta(db, 'derived_version')
+  if (version === undefined) {
+    return 'upgrade'
+  }
+  const stamped = Number(version)
+  const hash = meta(db, 'derived_hash')
+  if (stamped > ctx.spec.version) {
+    throw new FsqliteError(
+      'incompatible',
+      `store derived objects are version ${stamped}; this handle declares version ${ctx.spec.version}`,
+    )
+  }
+  if (stamped === ctx.spec.version && hash !== ctx.hash) {
+    throw new FsqliteError(
+      'incompatible',
+      `store derived_hash ${String(hash)} does not match this handle's ${ctx.hash} at derived version ${stamped}`,
+    )
+  }
+  return stamped < ctx.spec.version ? 'upgrade' : 'current'
+}
+
+/** Whether the snapshot at `db` needs a derived refresh under `ctx` (stamp absent or older). */
+export function needsRefresh(db: DatabaseSync, ctx: DerivedContext): boolean {
+  const version = meta(db, 'derived_version')
+  return version === undefined || Number(version) < ctx.spec.version
+}
+
+/** Drop every derived object; returns their names. */
+export function dropDerived(db: DatabaseSync, base: BaseInfo): string[] {
+  const objects = derivedObjects(db, base)
+  dropObjects(db, objects)
+  return objects.map((o) => o.name)
+}
+
+function dropObjects(db: DatabaseSync, objects: SchemaObject[]): void {
+  const tables = new Set(objects.filter((o) => o.type === 'table').map((o) => o.name))
+  for (const o of objects) {
+    if (o.type === 'view') {
+      db.exec(`DROP VIEW IF EXISTS ${quote(o.name)}`)
+    }
+  }
+  for (const o of objects) {
+    if (o.type === 'index' && !tables.has(o.tbl_name)) {
+      db.exec(`DROP INDEX IF EXISTS ${quote(o.name)}`)
+    }
+  }
+  for (const name of tables) {
+    db.exec(`DROP TABLE IF EXISTS ${quote(name)}`)
+  }
+}
+
+function createObjects(db: DatabaseSync, objects: SchemaObject[]): void {
+  const order = ['table', 'index', 'view']
+  for (const type of order) {
+    for (const o of objects) {
+      if (o.type === type && o.sql) {
+        db.exec(o.sql)
+      }
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------------------
+// Changed keys from a changeset (SQLite session format).
+
+const OP_INSERT = 18
+const OP_UPDATE = 23
+const OP_DELETE = 9
+type KeyValue = ChangedRow['key'][number]
+export type WantRows = (table: string) => 'all' | 'deletes' | 'none'
+
+/**
+ * Add the primary keys of every row `changeset` changes to `into`, for the tables `want`
+ * selects. Returns the table names the changeset names, in order. Patchsets are refused.
+ */
+export function collectChanges(
+  changeset: Uint8Array,
+  into: ChangedKeys | null,
+  want: WantRows = () => 'all',
+): { tables: string[]; rows: number } {
+  const buf = Buffer.from(changeset.buffer, changeset.byteOffset, changeset.byteLength)
+  const n = buf.length
+  let i = 0
+  let rows = 0
+  const tables: string[] = []
+  let nCol = 0
+  let isPk: boolean[] = []
+  let mode: 'all' | 'deletes' | 'none' = 'none'
+  let list: ChangedRow[] | null = null
+  const varint = (): number => {
+    let v = 0
+    for (let k = 0; k < 9; k++) {
+      const b = buf[i++] ?? 0
+      if (k === 8) {
+        return v * 256 + b
+      }
+      v = v * 128 + (b & 0x7f)
+      if ((b & 0x80) === 0) {
+        return v
+      }
+    }
+    return v
+  }
+  const skipValue = (): void => {
+    const t = buf[i++]
+    if (t === 1 || t === 2) {
+      i += 8
+    } else if (t === 3 || t === 4) {
+      const len = varint()
+      i += len
+    }
+  }
+  const readValue = (): KeyValue => {
+    const t = buf[i++] ?? 0
+    switch (t) {
+      case 1: {
+        const v = buf.readBigInt64BE(i)
+        i += 8
+        return v >= BigInt(Number.MIN_SAFE_INTEGER) && v <= BigInt(Number.MAX_SAFE_INTEGER)
+          ? Number(v)
+          : v
+      }
+      case 2: {
+        const v = buf.readDoubleBE(i)
+        i += 8
+        return v
+      }
+      case 3:
+      case 4: {
+        const len = varint()
+        const s = buf.subarray(i, i + len)
+        i += len
+        return t === 3 ? s.toString('utf8') : new Uint8Array(s)
+      }
+      default:
+        // 5 is NULL; 0 (no value) appears only in an update's new record, never in a key.
+        return null
+    }
+  }
+  const record = (collect: boolean): KeyValue[] | null => {
+    if (!collect) {
+      for (let c = 0; c < nCol; c++) {
+        skipValue()
+      }
+      return null
+    }
+    const key: KeyValue[] = []
+    for (let c = 0; c < nCol; c++) {
+      if (isPk[c]) {
+        key.push(readValue())
+      } else {
+        skipValue()
+      }
+    }
+    return key
+  }
+  while (i < n) {
+    const tag = buf[i]
+    if (tag === 0x54) {
+      i++
+      nCol = varint()
+      isPk = []
+      for (let c = 0; c < nCol; c++) {
+        isPk.push(buf[i + c] !== 0)
+      }
+      i += nCol
+      const end = buf.indexOf(0, i)
+      const name = buf.toString('utf8', i, end)
+      i = end + 1
+      tables.push(name)
+      mode = into === null ? 'none' : want(name)
+      if (into !== null && mode !== 'none') {
+        list = into.get(name) ?? []
+        into.set(name, list)
+      } else {
+        list = null
+      }
+      continue
+    }
+    if (tag === 0x50) {
+      throw new FsqliteError('refused', 'derived builds need changesets, not patchsets')
+    }
+    const op = buf[i] ?? 0
+    i += 2
+    rows++
+    if (op === OP_DELETE) {
+      const key = record(list !== null)
+      if (key && list) {
+        list.push({ op: 'delete', key })
+      }
+    } else if (op === OP_INSERT) {
+      const key = record(list !== null && mode === 'all')
+      if (key && list) {
+        list.push({ op: 'insert', key })
+      }
+    } else if (op === OP_UPDATE) {
+      const key = record(list !== null && mode === 'all')
+      record(false)
+      if (key && list) {
+        list.push({ op: 'update', key })
+      }
+    } else {
+      throw new FsqliteError('corrupt', `unrecognized changeset operation ${op} at byte ${i - 2}`)
+    }
+  }
+  return { tables, rows }
+}
+
+/** The table names a changeset names, in order. */
+export function changesetTables(changeset: Uint8Array): string[] {
+  return collectChanges(changeset, null).tables
+}
+
+/** Refuse a changeset that names anything but base tables. */
+export function assertBaseOnly(tables: string[], base: BaseInfo, what: string): void {
+  const other = [...new Set(tables)].filter((t) => !base.tableSet.has(t))
+  if (other.length > 0) {
+    throw new FsqliteError(
+      'refused',
+      `${what} changed ${other.map((t) => `"${t}"`).join(', ')}, which ${
+        other.length === 1 ? 'is not a base table' : 'are not base tables'
+      }; derived objects and statistics are built by the generation build`,
+    )
+  }
+}
+
+// ---------------------------------------------------------------------------------------
+// The build steps.
+
+/** Delete child rows whose parent this build deleted and did not re-insert. */
+function applyRelations(db: DatabaseSync, ctx: DerivedContext, changes: ChangedKeys): number {
+  let removed = 0
+  for (const rel of ctx.relations) {
+    const deleted = (changes.get(rel.parent) ?? []).filter((r) => r.op === 'delete')
+    if (deleted.length === 0) {
+      continue
+    }
+    const parentCols = rel.parentColumns ?? ctx.base.pk.get(rel.parent) ?? []
+    const childPk = ctx.base.pk.get(rel.child) ?? []
+    const where = (cols: string[]): string => cols.map((c) => `${quote(c)} = ?`).join(' AND ')
+    const exists = db.prepare(`SELECT 1 FROM ${quote(rel.parent)} WHERE ${where(parentCols)}`)
+    const select = db.prepare(
+      `SELECT ${childPk.map(quote).join(', ')} FROM ${quote(rel.child)} WHERE ${where(rel.columns)}`,
+    )
+    const del = db.prepare(`DELETE FROM ${quote(rel.child)} WHERE ${where(rel.columns)}`)
+    const childChanges = changes.get(rel.child) ?? []
+    changes.set(rel.child, childChanges)
+    const seen = new Set<string>()
+    for (const r of deleted) {
+      const k = JSON.stringify(r.key, (_k, v: unknown) => (typeof v === 'bigint' ? String(v) : v))
+      if (seen.has(k)) {
+        continue
+      }
+      seen.add(k)
+      const key = r.key
+      if (exists.get(...key)) {
+        continue
+      }
+      const victims = select.all(...key) as Record<string, KeyValue>[]
+      if (victims.length === 0) {
+        continue
+      }
+      for (const v of victims) {
+        childChanges.push({
+          op: 'delete',
+          key: childPk.map((c) => v[c] ?? null),
+        })
+      }
+      removed += Number(del.run(...key).changes)
+    }
+  }
+  return removed
+}
+
+function runStatistics(
+  db: DatabaseSync,
+  ctx: DerivedContext,
+  full: boolean,
+  newIndexes: string[],
+): void {
+  const mode = ctx.spec.statistics ?? 'optimize'
+  if (mode === 'none') {
+    return
+  }
+  db.exec(`PRAGMA analysis_limit = ${ctx.analysisLimit}`)
+  if (full || mode === 'analyze') {
+    db.exec('ANALYZE')
+    return
+  }
+  for (const name of newIndexes) {
+    db.exec(`ANALYZE ${quote(name)}`)
+  }
+  db.exec('PRAGMA optimize = 0x10002')
+}
+
+function checkPlans(db: DatabaseSync, plans: PlanAssertion[]): BuildInfo['plans'] {
+  const out: BuildInfo['plans'] = []
+  for (const [n, p] of plans.entries()) {
+    const uses = Array.isArray(p.uses) ? p.uses : [p.uses]
+    const plan = (db.prepare(`EXPLAIN QUERY PLAN ${p.sql}`).all() as { detail: string }[]).map(
+      (r) => r.detail,
+    )
+    const ok = plan.some((d) =>
+      uses.some((u) => d.includes(`USING INDEX ${u}`) || d.includes(`USING COVERING INDEX ${u}`)),
+    )
+    const name = p.name ?? `plan ${n}`
+    out.push({ name, uses, ok, plan })
+    if (!ok) {
+      throw new FsqliteError(
+        'refused',
+        `plan assertion ${name} failed: expected ${uses.join(' or ')}; the plan is: ${plan.join('; ')}`,
+      )
+    }
+  }
+  return out
+}
+
+function stamp(db: DatabaseSync, ctx: DerivedContext): void {
+  const put = db.prepare(
+    'INSERT INTO fsqlite_meta (key, value) VALUES (?, ?) ON CONFLICT (key) DO UPDATE SET value = excluded.value',
+  )
+  put.run('base_tables', JSON.stringify(ctx.base.tables))
+  put.run('derived_version', String(ctx.spec.version))
+  put.run('derived_hash', ctx.hash)
+}
+
+export function newBuildInfo(lane: BuildInfo['lane'], cacheKiB: number | undefined): BuildInfo {
+  return {
+    lane,
+    mode: 'none',
+    buildCacheKiB: cacheKiB ?? null,
+    envelopes: 0,
+    changedRows: 0,
+    drop_ms: 0,
+    apply_ms: 0,
+    changes_ms: 0,
+    closure_ms: 0,
+    closureRemoved: 0,
+    derive_ms: 0,
+    statistics_ms: 0,
+    plans_ms: 0,
+    hook_ms: 0,
+    gate: 'none',
+    gate_ms: 0,
+    plans: [],
+    createdObjects: [],
+    droppedObjects: [],
+  }
+}
+
+export interface DeriveArgs {
+  /** `rebuild`: the derived objects were dropped before the build's writes. */
+  mode: 'rebuild' | 'update'
+  /** The store's stamp is absent or older than the handle's version. */
+  upgrade: boolean
+  /** Changed base keys, or null when they are unknown (then the hook rebuilds). */
+  changes: ChangedKeys | null
+  /** Run inside the caller's open transaction instead of opening one. */
+  inTransaction: boolean
+  checkPlans: boolean
+  info: BuildInfo
+}
+
+/**
+ * The derived step of one build: closure relations, then the derived objects (created and
+ * rebuilt, diffed to a new version, or updated for the changed keys), statistics, plan
+ * assertions, and the stamp. Returns whether the gate must check derived virtual tables.
+ */
+export function deriveInBuild(db: DatabaseSync, ctx: DerivedContext, args: DeriveArgs): boolean {
+  const info = args.info
+  const before = baseFingerprint(db, ctx.base)
+  if (!args.inTransaction) {
+    db.exec('BEGIN IMMEDIATE')
+  }
+  let fullGate = false
+  try {
+    const changes = args.changes ?? new Map<string, ChangedRow[]>()
+    info.changedRows = [...changes.values()].reduce((n, l) => n + l.length, 0)
+    // `fresh`: the derived tables were created empty in this step, so they need `rebuild`.
+    let fresh = false
+    let t = now()
