+test('derived: collectChanges reads primary keys per operation from a changeset', () => {
+  const db = new DatabaseSync(':memory:')
+  db.exec(BASE)
+  db.prepare('INSERT INTO edge VALUES (?, ?, ?, ?)').run('a', 'r', 'b', 0)
+  const s = db.createSession()
+  db.prepare('INSERT INTO entity VALUES (?, ?, ?)').run('x', 'k', 'X')
+  db.prepare('INSERT INTO edge VALUES (?, ?, ?, ?)').run('a', 'r', 'c', 7)
+  db.prepare("DELETE FROM edge WHERE target = 'b'").run()
+  db.prepare("UPDATE entity SET label = 'Y' WHERE id = 'x'").run()
+  const changes: ChangedKeys = new Map()
+  const out = collectChanges(s.changeset(), changes)
+  s.close()
+  db.close()
+  assert.deepEqual(out.tables.sort(), ['edge', 'entity'])
+  assert.deepEqual(changes.get('entity'), [{ op: 'insert', key: ['x'] }])
+  assert.deepEqual((changes.get('edge') ?? []).map((r) => [r.op, ...r.key]).sort(), [
+    ['delete', 'a', 'r', 'b', 0],
+    ['insert', 'a', 'r', 'c', 7],
+  ])
+})
