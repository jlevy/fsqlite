+test('derived: a version bump rebuilds in place and keeps store_id; an older or divergent handle is refused', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const v1 = new SnapshotStore(dir, options()).init()
+    v1.write('w', (db) => {
+      person(db, 'person:a', 'Ada Copilot', 'org:x')
+    })
+    v1.reconcile()
+    const storeId = (): string =>
+      (JSON.parse(readFileSync(join(dir, 'fsqlite.json'), 'utf8')) as { store_id: string }).store_id
+    const id = storeId()
+    // Only an index changes: it is created, nothing else is rebuilt.
+    const builds: BuildInfo[] = []
+    const v2 = new SnapshotStore(
+      dir,
+      options(
+        {
+          derived: derived({
+            version: 2,
+            ddl: `${DDL}\nCREATE INDEX ix_entity_label ON entity (label);`,
+          }),
+        },
+        builds,
+      ),
+    ).init()
+    const res = v2.reconcile()
+    assert.equal(res.published, 2, 'a derived refresh publishes with no pending envelopes')
+    assert.deepEqual(builds.at(-1)?.createdObjects, ['ix_entity_label'])
+    assert.equal(builds.at(-1)?.mode, 'refresh')
+    assert.equal(storeId(), id)
+    assert.equal(facts(v2.snapshotPath(2)).meta.derived_version, '2')
+    // A derived table is added: the derived tables are rebuilt.
+    const v3 = new SnapshotStore(
+      dir,
+      options(
+        {
+          derived: derived({
+            version: 3,
+            ddl: `${DDL}\nCREATE TABLE kind_count (kind TEXT PRIMARY KEY NOT NULL, n INTEGER NOT NULL);`,
+            plans: [],
+          }),
+        },
+        builds,
+      ),
+    ).init()
+    v3.reconcile()
+    assert.ok(builds.at(-1)?.createdObjects.includes('facet_count'))
+    assert.deepEqual(facts(v3.snapshotPath(3)).fts, ['person:a'])
+    v1.write('w', (db) => {
+      person(db, 'person:b', 'B', 'org:x')
+    })
+    assert.throws(
+      () => v1.reconcile(),
+      (e: unknown) => e instanceof FsqliteError && e.code === 'incompatible',
+    )
+    const divergent = new DirectStore(dir, options({ derived: derived({ version: 3 }) }))
+    assert.throws(
+      () =>
+        divergent.write((db) => {
+          person(db, 'person:c', 'C', 'org:x')
+        }),
+      /derived_hash/,
+    )
+  } finally {
+    cleanup()
+  }
+})
