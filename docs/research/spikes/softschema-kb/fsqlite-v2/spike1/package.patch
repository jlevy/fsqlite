+/** PROTOTYPE: what one generation build did, in milliseconds. */
+export interface BuildInfo {
+  lane: 'init' | 'reconcile' | 'direct'
+  /** `rebuild`: derived objects dropped and rebuilt; `refresh`: a new derived version. */
+  mode: 'rebuild' | 'refresh' | 'update' | 'none'
+  buildCacheKiB: number | null
+  envelopes: number
+  changedRows: number
+  drop_ms: number
+  apply_ms: number
+  changes_ms: number
+  closure_ms: number
+  closureRemoved: number
+  derive_ms: number
+  statistics_ms: number
+  plans_ms: number
+  /** The hook: closure, derive, statistics, and plans, plus parsing the changed keys. */
+  hook_ms: number
+  gate: 'full' | 'tables' | 'none'
+  gate_ms: number
+  plans: { name: string; uses: string[]; ok: boolean; plan: string[] }[]
+  createdObjects: string[]
+  droppedObjects: string[]
 }
 
 /**
diff -ruN a/packages/fsqlite/test/derived.test.ts b/packages/fsqlite/test/derived.test.ts
--- a/packages/fsqlite/test/derived.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/packages/fsqlite/test/derived.test.ts	2026-11-17 04:45:54.539660298 +0000
@@ -0,0 +1,493 @@
+// PROTOTYPE (fsqlite v2, Spike 1): derived objects, statistics, plan assertions, and closure
+// relations built inside each generation build, through both write strategies.
+
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { execFileSync } from 'node:child_process'
+import { readdirSync, readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+import { DirectStore, FsqliteError, SnapshotStore } from '../src/index.ts'
+import { collectChanges } from '../src/derived.ts'
+import type { BuildInfo, ChangedKeys, DerivedSpec, StoreOptions } from '../src/types.ts'
+import { tmpStore } from './fixture.ts'
+
+const BASE = `
+CREATE TABLE entity (id TEXT PRIMARY KEY NOT NULL, kind TEXT NOT NULL, label TEXT NOT NULL);
+CREATE TABLE edge (source TEXT NOT NULL, relation TEXT NOT NULL, target TEXT NOT NULL,
+  ord INTEGER NOT NULL, PRIMARY KEY (source, relation, target, ord)) WITHOUT ROWID;
+`
+const DDL = `
+CREATE INDEX ix_entity_kind_label ON entity (kind, label, id);
+CREATE INDEX ix_edge_in ON edge (target, relation, source);
+CREATE VIRTUAL TABLE search_fts USING fts5(text, id UNINDEXED, tokenize = 'trigram');
+CREATE TABLE facet_count (relation TEXT NOT NULL, target TEXT NOT NULL, n INTEGER NOT NULL,
+  PRIMARY KEY (relation, target)) WITHOUT ROWID;
+`
+
+function rebuild(db: DatabaseSync): void {
+  db.exec(`
+    INSERT INTO search_fts (text, id) SELECT lower(label), id FROM entity ORDER BY id;
+    INSERT INTO facet_count SELECT relation, target, count(DISTINCT source) FROM edge GROUP BY relation, target;
+  `)
+}
+
+/** Incremental: recompute the search rows and facet groups the changed keys touch. */
+function update(db: DatabaseSync, changes: ChangedKeys): void {
+  const ids = new Set((changes.get('entity') ?? []).map((r) => String(r.key[0])))
+  for (const id of ids) {
+    db.prepare('DELETE FROM search_fts WHERE id = ?').run(id)
+    db.prepare(
+      'INSERT INTO search_fts (text, id) SELECT lower(label), id FROM entity WHERE id = ?',
+    ).run(id)
+  }
+  const groups = new Set(
+    (changes.get('edge') ?? []).map((r) => JSON.stringify([r.key[1], r.key[2]])),
+  )
+  for (const g of groups) {
+    const [relation, target] = JSON.parse(g) as [string, string]
+    db.prepare('DELETE FROM facet_count WHERE relation = ? AND target = ?').run(relation, target)
+    db.prepare(
+      `INSERT INTO facet_count SELECT relation, target, count(DISTINCT source) FROM edge
+       WHERE relation = ? AND target = ? GROUP BY relation, target`,
+    ).run(relation, target)
+  }
+}
+
+const derived = (over: Partial<DerivedSpec> = {}): DerivedSpec => ({
+  version: 1,
+  ddl: DDL,
+  rebuild,
+  update,
+  plans: [
+    {
+      name: 'kind page',
+      sql: "SELECT id FROM entity WHERE kind = 'person' ORDER BY label, id",
+      uses: 'ix_entity_kind_label',
+    },
+  ],
+  ...over,
+})
+
+function options(over: Partial<StoreOptions> = {}, builds?: BuildInfo[]): StoreOptions {
+  return {
+    schema: BASE,
+    schemaVersion: 1,
+    conflictPolicy: { entity: 'lww', edge: 'lww' },
+    derived: derived(),
+    relations: [
+      {
+        child: 'edge',
+        columns: ['source'],
+        parent: 'entity',
+        onMissing: 'delete',
+      },
+      {
+        child: 'edge',
+        columns: ['target'],
+        parent: 'entity',
+        onMissing: 'delete',
+      },
+    ],
+    buildCacheKiB: 65536,
+    onBuild: (info) => builds?.push(info),
+    ...over,
+  }
+}
+
+const person = (db: DatabaseSync, id: string, label: string, org: string): void => {
+  db.prepare(
+    'INSERT INTO entity VALUES (?, ?, ?) ON CONFLICT (id) DO UPDATE SET label = excluded.label',
+  ).run(id, 'person', label)
+  db.prepare('INSERT INTO entity VALUES (?, ?, ?) ON CONFLICT (id) DO NOTHING').run(org, 'org', org)
+  db.prepare('INSERT INTO edge VALUES (?, ?, ?, 0) ON CONFLICT DO NOTHING').run(
+    id,
+    'affiliated_with',
+    org,
+  )
+}
+
+function facts(path: string) {
+  const db = new DatabaseSync(path, { readOnly: true })
+  try {
+    return {
+      fts: (
+        db
+          .prepare(`SELECT id FROM search_fts WHERE search_fts MATCH '"copilot"' ORDER BY id`)
+          .all() as { id: string }[]
+      ).map((r) => r.id),
+      facets: db
+        .prepare('SELECT target, n FROM facet_count ORDER BY target')
+        .all()
+        .map((r) => ({ ...r })),
+      stat1: (
+        db.prepare("SELECT count(*) AS n FROM sqlite_schema WHERE name = 'sqlite_stat1'").get() as {
+          n: number
+        }
+      ).n,
+      meta: Object.fromEntries(
+        (
+          db
+            .prepare(
+              "SELECT key, value FROM fsqlite_meta WHERE key LIKE 'derived_%' OR key = 'base_tables'",
+            )
+            .all() as { key: string; value: string }[]
+        ).map((r) => [r.key, r.value]),
+      ),
+      dangling: (
+        db
+          .prepare(
+            `SELECT count(*) AS n FROM edge g WHERE NOT EXISTS (SELECT 1 FROM entity e WHERE e.id = g.source)
+           OR NOT EXISTS (SELECT 1 FROM entity e WHERE e.id = g.target)`,
+          )
+          .get() as { n: number }
+      ).n,
+    }
+  } finally {
+    db.close()
+  }
+}
+
+test('derived: virtual tables pass init and validate; snapshot 0 carries empty derived objects', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const builds: BuildInfo[] = []
+    const store = new SnapshotStore(dir, options({}, builds)).init()
+    assert.equal(builds[0]?.lane, 'init')
+    const f = facts(store.snapshotPath(0))
+    assert.deepEqual(f.fts, [])
+    assert.equal(f.meta.derived_version, '1')
+    assert.equal(f.meta.base_tables, '["entity","edge"]')
+    assert.equal(store.validate().state, 'sealed')
+  } finally {
+    cleanup()
+  }
+})
+
+test('derived: envelopes and a direct write publish generations with FTS5, facets, and statistics', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const builds: BuildInfo[] = []
+    const a = new SnapshotStore(dir, options({}, builds)).init()
+    const b = new SnapshotStore(dir, options({}, builds)).init()
+    a.write('agentA', (db) => {
+      person(db, 'person:cy', 'Cy Copilot', 'org:github')
+    })
+    b.write('agentB', (db) => {
+      person(db, 'person:gh', 'GitHub Copilot Fan', 'org:github')
+    })
+    assert.deepEqual(a.reconcile(), {
+      published: 1,
+      applied: 2,
+      quarantined: 0,
+      attempts: 1,
+    })
+    const r = builds.at(-1)
+    assert.ok(r)
+    assert.equal(r.lane, 'reconcile')
+    assert.equal(r.buildCacheKiB, 65536)
+    assert.ok(r.plans.length === 1 && r.plans[0]?.ok)
+    let f = facts(a.snapshotPath(1))
+    assert.deepEqual(f.fts, ['person:cy', 'person:gh'])
+    assert.deepEqual(f.facets, [{ target: 'org:github', n: 2 }])
+    assert.equal(f.stat1, 1)
+    const direct = new DirectStore(dir, options({}, builds))
+    direct.write((db) => {
+      person(db, 'person:linus', 'Linus Copilot Skeptic', 'org:github')
+    })
+    assert.equal(builds.at(-1)?.lane, 'direct')
+    assert.equal(builds.at(-1)?.mode, 'update')
+    assert.ok((builds.at(-1)?.changedRows ?? 0) >= 2, 'the session reported the changed keys')
+    f = facts(direct.snapshotPath(2))
+    assert.deepEqual(f.fts, ['person:cy', 'person:gh', 'person:linus'])
+    assert.deepEqual(f.facets, [{ target: 'org:github', n: 3 }])
+    assert.equal(a.validate().state, 'sealed')
+    // Standard tools read the generation, FTS5 included.
+    const py = execFileSync(
+      'python3',
+      [
+        '-c',
+        "import sqlite3,sys;db=sqlite3.connect('file:'+sys.argv[1]+'?mode=ro&immutable=1',uri=True);print(db.execute(\"SELECT count(*) FROM search_fts WHERE search_fts MATCH '\\\"copilot\\\"'\").fetchone()[0])",
+        direct.snapshotPath(2),
+      ],
+      { encoding: 'utf8' },
+    )
+    assert.equal(py.trim(), '3')
+  } finally {
+    cleanup()
+  }
+})
+
+test('derived: a capture that writes a derived table or statistics is refused; one that reconcile sees is quarantined', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const store = new SnapshotStore(dir, options()).init()
+    assert.throws(
+      () =>
+        store.write('w', (db) =>
+          db.prepare('INSERT INTO facet_count VALUES (?, ?, ?)').run('r', 't', 9),
+        ),
+      (e: unknown) =>
+        e instanceof FsqliteError && e.code === 'refused' && e.message.includes('facet_count'),
+    )
+    store.write('w', (db) => {
+      person(db, 'person:a', 'A', 'org:x')
+    })
+    store.reconcile()
+    assert.throws(
+      () =>
+        store.write('w', (db) => {
+          db.exec('ANALYZE')
+        }),
+      (e: unknown) => e instanceof FsqliteError && e.message.includes('sqlite_stat1'),
+    )
+    // A handle without the derived rule captures it; reconcile quarantines it.
+    const plain = new SnapshotStore(dir, {
+      schema: BASE,
+      schemaVersion: 1,
+      conflictPolicy: { entity: 'lww', edge: 'lww' },
+    }).init()
+    plain.write('rogue', (db) =>
+      db.prepare('INSERT INTO facet_count VALUES (?, ?, ?)').run('r', 't', 9),
+    )
+    const res = store.reconcile()
+    assert.equal(res.quarantined, 1)
+    const q = readdirSync(join(dir, 'tx', 'quarantine'))
+    assert.match(
+      readFileSync(join(dir, 'tx', 'quarantine', q[0] ?? '', 'QUARANTINE'), 'utf8'),
+      /non-base table facet_count/,
+    )
+    const dw = new DirectStore(dir, options())
+    assert.throws(
+      () => dw.write((db) => db.prepare("DELETE FROM search_fts WHERE id = 'person:a'").run()),
+      (e: unknown) => e instanceof FsqliteError && e.code === 'refused',
+    )
+  } finally {
+    cleanup()
+  }
+})
