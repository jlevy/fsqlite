+test('derived: a hook failure or a failed plan assertion publishes nothing and leaves no transient', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    new SnapshotStore(dir, options()).init()
+    let fail = false
+    const failing = new SnapshotStore(
+      dir,
+      options({
+        derived: derived({
+          update: (db, ch) => {
+            if (fail) {
+              throw new Error('hook boom')
+            }
+            update(db, ch)
+          },
+        }),
+      }),
+    )
+    failing.write('w', (db) => {
+      person(db, 'person:a', 'A', 'org:x')
+    })
+    fail = true
+    assert.throws(() => failing.reconcile(), /hook boom/)
+    assert.equal(failing.currentVersion(), 0)
+    assert.equal(failing.pendingTxns().length, 1, 'the envelope stays pending')
+    assert.deepEqual(
+      readdirSync(join(dir, 'snapshots')).filter((f) => f.startsWith('.')),
+      [],
+    )
+    const strict = new DirectStore(
+      dir,
+      options({
+        derived: derived({
+          plans: [
+            {
+              name: 'no-such-plan',
+              sql: "SELECT label FROM entity WHERE id = 'x'",
+              uses: 'ix_entity_kind_label',
+            },
+          ],
+        }),
+      }),
+    )
+    assert.throws(
+      () =>
+        strict.write((db) => {
+          person(db, 'person:b', 'B', 'org:x')
+        }),
+      (e: unknown) =>
+        e instanceof FsqliteError &&
+        e.code === 'refused' &&
+        e.message.includes('plan assertion no-such-plan'),
+    )
+    assert.equal(strict.currentVersion(), 0)
+    assert.deepEqual(
+      readdirSync(join(dir, 'snapshots')).filter((f) => f.startsWith('.')),
+      [],
+    )
+  } finally {
+    cleanup()
+  }
+})
