+test('derived: closure removes edges whose endpoint another envelope deleted', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const builds: BuildInfo[] = []
+    const store = new SnapshotStore(dir, options({}, builds)).init()
+    store.write('seed', (db) => {
+      person(db, 'person:a', 'A', 'org:x')
+      person(db, 'person:b', 'B', 'org:y')
+    })
+    store.reconcile()
+    // Two writers from the same head: one deletes org:x, the other adds an edge to it.
+    store.write('deleter', (db) => {
+      db.exec("DELETE FROM edge WHERE target = 'org:x' OR source = 'org:x'")
+      db.exec("DELETE FROM entity WHERE id = 'org:x'")
+    })
+    store.write('adder', (db) =>
+      db.prepare('INSERT INTO edge VALUES (?, ?, ?, 0)').run('person:b', 'knows', 'org:x'),
+    )
+    const res = store.reconcile()
+    assert.equal(res.applied, 2)
+    assert.equal(builds.at(-1)?.closureRemoved, 1)
+    const f = facts(store.snapshotPath(res.published))
+    assert.equal(f.dangling, 0)
+    assert.deepEqual(
+      f.facets,
+      [{ target: 'org:y', n: 1 }],
+      'the derived update saw the closure removal',
+    )
+  } finally {
+    cleanup()
+  }
+})
