+      )
+      .all() as { detail: string }[]
+  ).map((r) => r.detail)
+  check.close()
+  out.same_store = {
+    route: 'derived version bump; one reconcile with no pending envelopes publishes it',
+    open_ms: round(tInit - t0),
+    publish_ms: round(t1 - tInit),
+    total_ms: round(t1 - t0),
+    version_before: versionBefore,
+    published: res.published,
+    store_id_unchanged: readStoreMarker(dir).store_id === idBefore,
+    build,
+    plan,
+    new_index_used: plan.some((d) => d.includes('ix_view_repos_by_stars')),
+  }
+  return out
