+#!/usr/bin/env bash
+# fsqlite v2 Spike 1 (derive at build): the measurements the design lists, at one scale.
+#
+# Usage: fsqlite/run_spike1.sh S1|S2|S1-r2|S2-r2
+#
+# Results go to results/fsqlite-v2/spike1/<scale>/. Working stores go to
+# $KB_SCRATCH/fsqlite-spike/<scale> and are deleted at the end. Environment:
+#   H4_ROUNDS     rounds of the round-2 build-cache matrix (default 3)
+#   W2_CLOSURE=0  skip the round-2 four-writer run that checks the in-build closure
+#   TRICKLE_SECONDS, TRICKLE_REPS as in run.sh
+set -euo pipefail
+
+SCALE=${1:?usage: run_spike1.sh <scale>}
+HERE=$(cd "$(dirname "$0")" && pwd)
+SCRATCH=${KB_SCRATCH:?set KB_SCRATCH to a directory holding kb-corpora}
+WORK=$SCRATCH/fsqlite-spike/$SCALE
+DELTAS=$SCRATCH/kb-corpora/$SCALE/deltas
+NODE=(node --disable-warning=ExperimentalWarning)
+cd "$HERE"
+
+case "$SCALE" in
+  *-r2)
+    # W1 with the schema check as a phase, through DirectStore; its store serves W3, the plan
+    # audit with the plan-assertion builds, and the four-writer closure check.
+    "${NODE[@]}" w1.ts --scale "$SCALE" --validate --routes direct
+    "${NODE[@]}" w3.ts "$WORK/store-direct" --scale "$SCALE"
+    "${NODE[@]}" w3.ts "$WORK/store-direct" --scale "$SCALE" --name w3-fts --fts-inline --facet-summary
+    "${NODE[@]}" plans.ts "$WORK/store-direct" --scale "$SCALE"
+    if [ "${W2_CLOSURE:-1}" != 0 ]; then
+      "${NODE[@]}" w2.ts "$WORK/store-direct" --scale "$SCALE" --deltas "$DELTAS" \
+        --no-closure-envelope --name w2-inbuild-closure
+    fi
+    rm -rf "$WORK/store-direct"
+    # H4: the SnapshotStore import's reconcile with a 256 MiB and the default 2 MB build
+    # cache, with the derived objects and, as a control, with the f1.0 schema.
+    for r in $(seq 1 "${H4_ROUNDS:-3}"); do
+      "${NODE[@]}" w1.ts --scale "$SCALE" --routes snapshot --reuse-rows --name "w1-h4-v2-256m-r$r"
+      FSQ_BUILD_CACHE_KIB=2000 "${NODE[@]}" w1.ts --scale "$SCALE" --routes snapshot \
+        --reuse-rows --name "w1-h4-v2-2m-r$r"
+      FSQ_NO_DERIVED=1 "${NODE[@]}" w1.ts --scale "$SCALE" --routes snapshot --reuse-rows \
+        --name "w1-h4-f10-256m-r$r"
+      FSQ_NO_DERIVED=1 FSQ_BUILD_CACHE_KIB=2000 "${NODE[@]}" w1.ts --scale "$SCALE" \
+        --routes snapshot --reuse-rows --name "w1-h4-f10-2m-r$r"
+    done
+    ;;
+  *)
+    "${NODE[@]}" w1.ts --scale "$SCALE" --routes direct
+    rm -f "$WORK/rows.jsonl"
+    "${NODE[@]}" w3.ts "$WORK/store-direct" --scale "$SCALE"
+    "${NODE[@]}" w3.ts "$WORK/store-direct" --scale "$SCALE" --name w3-fts --fts-inline --facet-summary
+    "${NODE[@]}" plans.ts "$WORK/store-direct" --scale "$SCALE"
+    "${NODE[@]}" trickle.ts "$WORK/store-direct" --scale "$SCALE" --delta "$DELTAS/p20" \
+      --seconds "${TRICKLE_SECONDS:-20}" --reps "${TRICKLE_REPS:-3}"
+    "${NODE[@]}" w4.ts --scale "$SCALE" --cases string_to_object --skip-typed --name w4-case5
+    ;;
+esac
+
+rm -rf "$WORK"
