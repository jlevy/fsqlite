+test('normalizeMissing defaults to quarantine and rejects unknown settings', () => {
+  assert.deepEqual(
+    { ...normalizeMissing({ t: 'lww' })['*'] },
+    { delete: 'quarantine', update: 'quarantine' },
+  )
+  assert.deepEqual(
