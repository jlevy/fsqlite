+// v2 design, Spike 2: operation envelopes with a serial reducer (k), sparse-seed changeset
+// capture (l), the missing-row policy and changeset admission (n), and the coalescing
+// publisher (d).
+
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createHash } from 'node:crypto'
+import { existsSync, readdirSync, readFileSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import type { DatabaseSync } from 'node:sqlite'
+import { SnapshotStore } from '../src/index.ts'
+import type { Reducer, StoreOptions } from '../src/index.ts'
+import { changesetTables, splitChangesetByOp } from '../src/changeset.ts'
+import { normalizeMissing } from '../src/conflictPolicy.ts'
+import { tmpStore } from './fixture.ts'
+
+const SCHEMA = `
+  CREATE TABLE node (id TEXT PRIMARY KEY NOT NULL, label TEXT NOT NULL);
+  CREATE TABLE edge (
+    source TEXT NOT NULL,
+    target TEXT NOT NULL,
+    props TEXT,
+    PRIMARY KEY (source, target)
+  ) WITHOUT ROWID;
+  CREATE INDEX ix_edge_target ON edge (target);
+`
+
+/** A reducer whose payload is JSON lines of `["node", id, label]` or `["edge", s, t]`. */
+const rows: Reducer = {
+  version: '1',
+  apply(db, payload) {
+    for (const line of Buffer.from(payload).toString('utf8').split('\n')) {
+      if (line === '') {
+        continue
+      }
+      const [kind, a, b] = JSON.parse(line) as [string, string, string]
+      if (kind === 'node') {
+        db.prepare(
+          'INSERT INTO node VALUES (?, ?) ON CONFLICT (id) DO UPDATE SET label = excluded.label',
+        ).run(a, b)
+      } else if (kind === 'edge') {
+        db.prepare('INSERT OR REPLACE INTO edge VALUES (?, ?, NULL)').run(a, b)
+      } else if (kind === 'unnode') {
+        db.prepare('DELETE FROM node WHERE id = ?').run(a)
+      } else if (kind === 'throw') {
+        throw new Error('reducer refused the payload')
+      } else if (kind === 'ledger') {
+        db.prepare('DELETE FROM applied_tx').run()
+      }
+    }
+  },
+}
+
+const lines = (...items: unknown[][]): Uint8Array =>
+  Buffer.from(items.map((i) => JSON.stringify(i)).join('\n'))
+
+const options = (extra: Partial<StoreOptions> = {}): StoreOptions => ({
+  schema: SCHEMA,
+  schemaVersion: 1,
+  conflictPolicy: { '*': 'lww' },
+  reducers: { rows },
+  ...extra,
+})
+
+const all = (store: SnapshotStore, sql: string): unknown[] =>
+  store.read((db) =>
+    db
+      .prepare(sql)
+      .all()
+      .map((r) => ({ ...r })),
+  )
+
+test('append commits a single-file envelope that reconcile folds through its reducer once', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const store = new SnapshotStore(dir, options()).init()
+    const a = store.append('w1', 'rows', lines(['node', 'a', 'A'], ['edge', 'a', 'b']))
+    const b = store.append('w2', 'rows', lines(['node', 'b', 'B']), {
+      durable: true,
+    })
+    assert.deepEqual(store.pendingTxns(), [`${a}.env`, `${b}.env`])
+    const first = store.reconcile()
+    assert.equal(first.applied, 2)
+    assert.deepEqual(first.appliedTxIds, [a, b])
+    assert.deepEqual(all(store, 'SELECT id, label FROM node ORDER BY id'), [
+      { id: 'a', label: 'A' },
+      { id: 'b', label: 'B' },
+    ])
+    assert.equal(
+      store.read(
+        (db) =>
+          (
+            db.prepare("SELECT value FROM fsqlite_meta WHERE key = 'reducer.rows'").get() as {
+              value: string
+            }
+          ).value,
+      ),
+      '1',
+    )
+    // Exactly once: an envelope copied back into pending is found in the ledger.
+    writeFileSync(
+      join(store.txPending, `${a}.env`),
+      readFileSync(join(store.txApplied, `${a}.env`)),
+    )
+    const again = store.reconcile()
+    assert.equal(again.applied, 0)
+    assert.equal(store.pendingTxns().length, 0)
+    assert.equal(store.validate().state, 'sealed')
+  } finally {
+    cleanup()
+  }
+})
+
+test('a reducer that throws, or that writes an owned table, quarantines only its envelope', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const store = new SnapshotStore(dir, options()).init()
+    store.append('w', 'rows', lines(['node', 'a', 'A']))
+    const bad = store.append('w', 'rows', lines(['node', 'x', 'X'], ['throw']))
+    const owned = store.append('w', 'rows', lines(['ledger']))
+    store.append('w', 'rows', lines(['node', 'c', 'C']))
+    const result = store.reconcile()
+    assert.equal(result.applied, 2)
+    assert.equal(result.quarantined, 2)
+    assert.deepEqual(all(store, 'SELECT id FROM node ORDER BY id'), [{ id: 'a' }, { id: 'c' }])
+    const reasons = Object.fromEntries(result.quarantineReasons ?? [])
+    assert.match(String(reasons[`${bad}.env`]), /^reducer-failed: reducer refused the payload/)
+    assert.match(String(reasons[`${owned}.env`]), /fsqlite-owned table applied_tx is read-only/)
+    assert.ok(existsSync(join(store.txQuarantine, `${bad}.env`)))
+    assert.match(
+      readFileSync(join(store.txQuarantine, `${bad}.env.QUARANTINE`), 'utf8'),
+      /reducer-failed/,
+    )
+  } finally {
+    cleanup()
+  }
+})
+
+test('reducer state is shared within one build and cleared when an envelope rolls back', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const seen: number[] = []
+    const counting: Reducer = {
+      version: '1',
+      apply(db, payload, ctx) {
+        const n = ((ctx.build.get('n') as number | undefined) ?? 0) + 1
+        ctx.build.set('n', n)
+        seen.push(n)
+        rows.apply(db, payload, ctx)
+      },
+    }
+    const store = new SnapshotStore(dir, options({ reducers: { rows: counting } })).init()
+    store.append('w', 'rows', lines(['node', 'a', 'A']))
+    store.append('w', 'rows', lines(['throw']))
+    store.append('w', 'rows', lines(['node', 'b', 'B']))
+    store.reconcile()
+    assert.deepEqual(seen, [1, 2, 1])
+  } finally {
+    cleanup()
+  }
+})
+
+test('an unknown reducer or a reducer version mismatch is refused at admission', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const writer = new SnapshotStore(dir, options()).init()
+    const old = writer.append('w', 'rows', lines(['node', 'a', 'A']), {
+      version: '0',
+    })
+    const unknown = writer.append('w', 'other', lines(['node', 'b', 'B']), {
+      version: '1',
+    })
+    const result = writer.reconcile()
+    const reasons = Object.fromEntries(result.quarantineReasons ?? [])
+    assert.match(
+      String(reasons[`${old}.env`]),
+      /^reducer-version-mismatch: envelope 0, reconciler 1/,
+    )
+    assert.match(String(reasons[`${unknown}.env`]), /^unknown-reducer: other/)
+    assert.throws(() => writer.append('w', 'nope', lines()), /not registered/)
+  } finally {
+    cleanup()
+  }
+})
+
+test('a tampered operation envelope is quarantined as a digest mismatch', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const store = new SnapshotStore(dir, options()).init()
+    const tx = store.append('w', 'rows', lines(['node', 'a', 'A']))
+    const path = join(store.txPending, `${tx}.env`)
+    writeFileSync(path, readFileSync(path, 'utf8').replace('"A"', '"Z"'))
+    const result = store.reconcile()
+    assert.equal(result.quarantined, 1)
+    assert.equal(result.quarantineReasons?.[0]?.[1], 'digest-mismatch')
+  } finally {
+    cleanup()
+  }
+})
+
+test('the closure hook runs inside the build after the envelopes, and a failure publishes nothing', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    let fail = false
+    const closure = (db: DatabaseSync): Record<string, unknown> => {
+      if (fail) {
+        throw new Error('closure failed')
+      }
+      const removed = db
+        .prepare('DELETE FROM edge WHERE NOT EXISTS (SELECT 1 FROM node WHERE id = edge.target)')
+        .run().changes
+      return { removed: Number(removed) }
+    }
+    const store = new SnapshotStore(dir, options({ closure })).init()
+    store.append('w', 'rows', lines(['node', 'a', 'A'], ['node', 'b', 'B'], ['edge', 'a', 'b']))
+    store.append('w', 'rows', lines(['unnode', 'b']))
+    const result = store.reconcile()
+    assert.deepEqual(result.closure, { removed: 1 })
+    assert.deepEqual(all(store, 'SELECT * FROM edge'), [])
+    fail = true
+    store.append('w', 'rows', lines(['node', 'c', 'C']))
+    assert.throws(() => store.reconcile(), /closure failed/)
+    assert.equal(store.currentVersion(), 1)
+    assert.equal(store.pendingTxns().length, 1)
+  } finally {
+    cleanup()
+  }
+})
+
+const NODES = (db: DatabaseSync): void => {
+  db.exec("INSERT INTO node VALUES ('a', 'A'), ('b', 'B'), ('c', 'C')")
+  db.exec("INSERT INTO edge VALUES ('a', 'b', NULL), ('a', 'c', NULL), ('b', 'c', NULL)")
+}
+
+test('sparse capture records the same changeset as a full copy for hydrated rows', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const store = new SnapshotStore(dir, options()).init()
+    store.write('seed', NODES)
+    store.reconcile()
+    const work = (db: DatabaseSync): void => {
+      db.exec("UPDATE node SET label = 'A2' WHERE id = 'a'")
+      db.exec("DELETE FROM edge WHERE source = 'a'")
+      db.exec("INSERT INTO edge VALUES ('c', 'a', '{}')")
+    }
+    const full = store.write('full', work)
+    const sparse = store.write('sparse', work, {
+      seed: 'sparse',
+      hydrate: (_db, copy) => {
+        assert.equal(copy('node', 'id = ?', 'a'), 1)
+        assert.equal(copy('edge', 'source = ?', 'a'), 2)
+      },
+    })
+    const changeset = (tx: string | null): string =>
+      readFileSync(join(store.txPending, `${tx ?? ''}.txn`, 'changeset.bin')).toString('hex')
+    assert.equal(changeset(sparse), changeset(full))
+    // The callback reads unhydrated rows through the attached head.
+    const seen = store.write(
+      'reader',
+      (db) => {
+        const n = (
+          db.prepare('SELECT count(*) AS n FROM head.edge').get() as {
+            n: number
+          }
+        ).n
+        db.prepare("INSERT INTO node VALUES ('count', ?)").run(String(n))
+      },
+      { seed: 'sparse' },
+    )
+    assert.ok(seen)
+    assert.equal(readdirSync(store.txPending).filter((f) => f.startsWith('.work-')).length, 0)
+  } finally {
+    cleanup()
+  }
+})
+
+test('two writers delete the same row: quarantined by default, idempotent with missingDelete ignore', () => {
+  for (const missingDelete of ['quarantine', 'ignore'] as const) {
+    const { dir, cleanup } = tmpStore()
+    try {
+      const store = new SnapshotStore(
+        dir,
+        options({
+          conflictPolicy: {
+            '*': 'lww',
+            edge: { conflict: 'lww', missingDelete },
+          },
+        }),
+      ).init()
+      store.write('seed', NODES)
+      store.reconcile()
+      store.write('one', (db) => {
+        db.exec("DELETE FROM edge WHERE source = 'a'")
+      })
+      store.write('two', (db) => {
+        db.exec("DELETE FROM edge WHERE source = 'a' AND target = 'b'")
+        db.exec("UPDATE node SET label = 'C2' WHERE id = 'c'")
+      })
+      const result = store.reconcile()
+      if (missingDelete === 'quarantine') {
+        assert.equal(result.quarantined, 1)
+        assert.match(String(result.quarantineReasons?.[0]?.[1]), /permanent-conflict: NOTFOUND/)
+      } else {
+        assert.equal(result.quarantined, 0)
+        assert.equal(result.omittedMissing, 1)
+        assert.deepEqual(all(store, "SELECT label FROM node WHERE id = 'c'"), [{ label: 'C2' }])
+      }
+      assert.deepEqual(all(store, 'SELECT source, target FROM edge'), [
+        { source: 'b', target: 'c' },
+      ])
+    } finally {
+      cleanup()
+    }
+  }
+})
+
+test('missingDelete ignore still reports an update of a missing row unless missingUpdate ignores it', () => {
+  for (const missingUpdate of ['quarantine', 'ignore'] as const) {
+    const { dir, cleanup } = tmpStore()
+    try {
+      const store = new SnapshotStore(
+        dir,
+        options({
+          conflictPolicy: {
+            '*': { conflict: 'lww', missingDelete: 'ignore', missingUpdate },
+          },
+        }),
+      ).init()
+      store.write('seed', NODES)
+      store.reconcile()
+      store.write('deleter', (db) => {
+        db.exec("DELETE FROM node WHERE id = 'b'")
+      })
+      store.write('updater', (db) => {
+        db.exec("UPDATE node SET label = 'B2' WHERE id = 'b'")
+      })
+      const result = store.reconcile()
+      assert.equal(result.quarantined, missingUpdate === 'quarantine' ? 1 : 0)
+      assert.deepEqual(all(store, "SELECT * FROM node WHERE id = 'b'"), [])
+    } finally {
+      cleanup()
+    }
+  }
+})
+
+test('a delete racing an update is a DATA conflict that the conflict action decides', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const store = new SnapshotStore(
+      dir,
+      options({
+        conflictPolicy: { '*': { conflict: 'union', missingDelete: 'ignore' } },
+      }),
+    ).init()
+    store.write('seed', NODES)
+    store.reconcile()
+    store.write('updater', (db) => {
+      db.exec("UPDATE node SET label = 'B2' WHERE id = 'b'")
+    })
+    store.write('deleter', (db) => {
+      db.exec("DELETE FROM node WHERE id = 'b'")
+    })
+    assert.equal(store.reconcile().quarantined, 0)
+    // union keeps the first writer's row: the delete of a changed row is omitted.
+    assert.deepEqual(all(store, "SELECT label FROM node WHERE id = 'b'"), [{ label: 'B2' }])
+  } finally {
+    cleanup()
+  }
+})
