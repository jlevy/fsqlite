+/** A switch for {@link guardOwnedTables}: armed while application code runs in a build. */
+export interface OwnedTableGuard {
+  arm: () => void
+  disarm: () => void
+}
+
+/**
+ * Guard fsqlite-owned tables on a build connection while a reducer runs (v2 design (k)).
+ * Unlike {@link protectOwnedTables}, the TEMP triggers fire only while the guard is armed,
+ * so fsqlite's own ledger insert after the reducer still works. The switch is a TEMP table
+ * row, so a rollback of the envelope's transaction also disarms it.
+ */
+export function guardOwnedTables(db: DatabaseSync): OwnedTableGuard {
+  db.exec(
+    'CREATE TEMP TABLE fsqlite_guard (armed INTEGER NOT NULL); INSERT INTO fsqlite_guard VALUES (0);',
+  )
+  for (const table of OWNED_TABLES) {
+    for (const action of ['INSERT', 'UPDATE', 'DELETE']) {
+      db.exec(`
+        CREATE TEMP TRIGGER fsqlite_guard_${table}_${action.toLowerCase()}
+        BEFORE ${action} ON main.${table}
+        WHEN (SELECT armed FROM temp.fsqlite_guard) = 1
+        BEGIN
+          SELECT RAISE(ABORT, 'fsqlite-owned table ${table} is read-only');
+        END;
+      `)
+    }
+  }
+  const set = db.prepare('UPDATE temp.fsqlite_guard SET armed = ?')
+  return { arm: () => void set.run(1), disarm: () => void set.run(0) }
+}
+
+/**
+ * Open a sparse-seed working database (v2 design (l)): an in-memory database that will
+ * hold the caller schema only, so a capture copies nothing. Foreign keys are not enforced
+ * here, because the parents of hydrated rows are usually absent; reconcile's
+ * `foreign_key_check` enforces them against the full build instead.
+ */
+export function openSparseWorkingCopy(): DatabaseSync {
+  const db = connect(':memory:')
+  db.exec('PRAGMA foreign_keys = OFF;')
+  return db
+}
