diff -ruN '--exclude=node_modules' '--exclude=dist' a/test/v2-spike2.test.ts b/test/v2-spike2.test.ts
--- a/test/v2-spike2.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/v2-spike2.test.ts	2026-11-17 04:53:18.655283312 +0000
