+#!/usr/bin/env bash
+# Spike 3 at S2, limited by this VM's free disk: W1 through DirectStore only (the
+# SnapshotStore route needs about 5 GB more), the W3 check, one full scrub, the trickle
+# through the f1.0 arm and the v2 arm on the same store, and W2 DirectStore p01 through
+# both arms. Run it only with at least 6 GB free; it deletes its stores at the end.
+#
+# Usage: fsqlite/run_spike3_s2.sh <f1.0 arm fsqlite dir>
+set -euo pipefail
+BASE_ARM=${1:?usage: run_spike3_s2.sh <f1.0 arm fsqlite dir>}
+HERE=$(cd "$(dirname "$0")" && pwd)
+KB_SCRATCH=${KB_SCRATCH:-$(cd "$HERE/../../kbscratch" && pwd)}; export KB_SCRATCH
+WORK=$KB_SCRATCH/fsqlite-spike/S2
+DELTAS=$KB_SCRATCH/kb-corpora/S2/deltas
+RESULTS=$HERE/../results/fsqlite-v2/spike3/S2
+NODE=(node --disable-warning=ExperimentalWarning)
+cd "$HERE"
+df -h "$KB_SCRATCH" | tail -1
+
+"${NODE[@]}" w1.ts --scale S2 --routes direct
+rm -f "$WORK/rows.jsonl"
+"${NODE[@]}" w3.ts "$WORK/store-direct" --scale S2
+python3 "$HERE/../harness/compare.py" "$HERE/../harness/expected/S2/w3.json" "$RESULTS/w3.json" \
+  | tail -1 | tee "$RESULTS/w3-compare.txt"
+# A scrub within the hour: the v2 trickle then pins the gate's quick records and keeps
+# this full-verified generation, which the clones share by hard link.
+"${NODE[@]}" --input-type=module -e "
+  const { pathToFileURL } = await import('node:url'); const [here, work] = process.argv.slice(1)
+  const { genericStore } = await import(pathToFileURL(here + '/w3.ts').href); const t = performance.now()
+  const r = genericStore(work + '/store-direct').init().verify(); console.log(JSON.stringify({ scrub_ms: performance.now() - t, ...r }))" "$HERE" "$WORK" | tee "$RESULTS/scrub.json"
+
+TRICKLE=(--scale S2 --delta "$DELTAS/p20" --seconds "${TRICKLE_SECONDS:-20}" --reps "${TRICKLE_REPS:-2}")
+(cd "$BASE_ARM" && KB_SCRATCH="$KB_SCRATCH/base" "${NODE[@]}" trickle.ts "$WORK/store-direct" "${TRICKLE[@]}" --name w2-trickle)
+KB_GC_OPTS='{"verifyMaxAgeMs":3600000,"collectOn":"quick"}' \
+  "${NODE[@]}" trickle.ts "$WORK/store-direct" "${TRICKLE[@]}" --name w2-trickle-quick
+
+mkdir -p "$WORK/deltas-p01" && ln -sfn "$DELTAS/p01" "$WORK/deltas-p01/p01"
+(cd "$BASE_ARM" && KB_SCRATCH="$KB_SCRATCH/base" "${NODE[@]}" w2.ts "$WORK/store-direct" --scale S2 \
+  --deltas "$WORK/deltas-p01" --strategy direct)
+"${NODE[@]}" w2.ts "$WORK/store-direct" --scale S2 --deltas "$WORK/deltas-p01" --strategy direct
+rm -rf "$WORK" "$KB_SCRATCH/base"
