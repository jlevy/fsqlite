+#!/usr/bin/env bash
+# Spike 3 (fsqlite v2: maintenance and publication): the workflows that test its four
+# hypotheses, at one scale, against the package copy in ../../package.
+#
+# Usage: fsqlite/run_spike3.sh S0|S1|S2
+#
+# Results go to results/fsqlite-v2/spike3/<scale>/. Working stores go to
+# $KB_SCRATCH/fsqlite-spike/<scale> and are deleted at the end.
+set -euo pipefail
+
+SCALE=${1:?usage: run_spike3.sh <scale>}
+HERE=$(cd "$(dirname "$0")" && pwd)
+KB_SCRATCH=${KB_SCRATCH:-$(cd "$HERE/../../kbscratch" && pwd)}; export KB_SCRATCH
+WORK=$KB_SCRATCH/fsqlite-spike/$SCALE
+DELTAS=$KB_SCRATCH/kb-corpora/$SCALE/deltas
+RESULTS=$HERE/../results/fsqlite-v2/spike3/$SCALE
+NODE=(node --disable-warning=ExperimentalWarning)
+cd "$HERE"
+
+# H3: W1 through both routes; w1.ts runs gc({ retain: 0 }) and records store_over_head.
+"${NODE[@]}" w1.ts --scale "$SCALE"
+# Every W3 run must still match the oracle.
+"${NODE[@]}" w3.ts "$WORK/store-direct" --scale "$SCALE"
+python3 "$HERE/../harness/compare.py" "$HERE/../harness/expected/$SCALE/w3.json" "$RESULTS/w3.json" \
+  | tail -1 | tee "$RESULTS/w3-compare.txt"
+
+# H1: DirectStore W2 with 4 contending writers and gc({ retain: 0 }) after every write,
+# with the package defaults (a full scrub of the pinned head on every collecting gc).
+"${NODE[@]}" w2.ts "$WORK/store-direct" --scale "$SCALE" --deltas "$DELTAS" --strategy direct
+
+# H2: the trickle, three gc configurations. Defaults (scrub every gc); the gate's quick
+# records pin gc and a full scrub runs once a minute; and the design's literal rule (pin
+# the newest full record, scrub once a minute), which collects nothing between scrubs and
+# so keeps one head per publish: S0 only (trickle.ts refuses it above S0 for disk).
+# S2 runs through run_spike3_s2.sh instead of this script.
+TRICKLE=(trickle.ts "$WORK/store-direct" --scale "$SCALE" --delta "$DELTAS/p20"
+  --seconds "${TRICKLE_SECONDS:-20}" --reps "${TRICKLE_REPS:-3}")
+"${NODE[@]}" "${TRICKLE[@]}" --name w2-trickle
+KB_GC_OPTS='{"verifyMaxAgeMs":60000,"collectOn":"quick"}' \
+  "${NODE[@]}" "${TRICKLE[@]}" --name w2-trickle-quick
+if [ "$SCALE" = S0 ]; then
+  KB_GC_OPTS='{"verifyMaxAgeMs":60000,"collectOn":"full"}' \
+    "${NODE[@]}" "${TRICKLE[@]}" --name w2-trickle-full-record
+fi
+
+# H4: W6, including the four crash kill points (S0 and S1; S2 skips them, as round 1 did).
+case "$SCALE" in S0 | S1) ;; *) rm -f "$WORK/rows.jsonl" ;; esac
+"${NODE[@]}" w6.ts --scale "$SCALE"
+
+rm -rf "$WORK"
