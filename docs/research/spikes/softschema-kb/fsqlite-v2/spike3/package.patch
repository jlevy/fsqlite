+// Worker that takes the publish lease in a DirectStore write, copies the head, and hangs
+// inside its callback, simulating a writer killed mid-build while it holds the lease. The
+// parent SIGKILLs it once the marker exists.
+//
+// argv: <dir> <markerPath>
+
+import { writeFileSync } from 'node:fs'
+import { DirectStore } from '../src/index.ts'
+import { STORE_OPTS } from '../test/fixture.ts'
+
+const [dir = '', markerPath = ''] = process.argv.slice(2)
+new DirectStore(dir, STORE_OPTS).write(
+  (db) => {
+    db.prepare('INSERT INTO artifacts VALUES (?,?,?)').run('hung', 'H', 't')
+    writeFileSync(markerPath, String(process.pid))
+    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 10_000_000) // until SIGKILL
+  },
+  { lockOpts: { timeoutMs: 600_001, staleMs: 600_000 } },
+)
diff -ruN '--exclude=node_modules' '--exclude=dist' a/workers/lease-racer.ts b/workers/lease-racer.ts
--- a/workers/lease-racer.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/workers/lease-racer.ts	2026-11-17 05:01:07.525277481 +0000
@@ -0,0 +1,36 @@
+// Worker that races other processes for the publish lease and proves exclusion: inside
+// the lease it creates `<inside>` with mkdir (which fails if another holder is inside),
+// holds it briefly, and removes it. It prints {rounds, overlaps, lostFences}.
+//
+// argv: <lockPath> <insideDir> <rounds> <staleMs>
+
+import { mkdirSync, rmdirSync } from 'node:fs'
+import { sleepSync, withLock } from '../src/lock.ts'
+
+const [lockPath = '', inside = '', roundsArg = '10', staleArg = '5000'] = process.argv.slice(2)
+const staleMs = Number(staleArg)
+let overlaps = 0
+let lostFences = 0
+for (let i = 0; i < Number(roundsArg); i++) {
+  withLock(
+    lockPath,
+    (_token, lease) => {
+      let entered = false
+      try {
+        mkdirSync(inside)
+        entered = true
+      } catch {
+        overlaps++
+      }
+      sleepSync(2)
+      if (!lease.fence()) {
+        lostFences++
+      }
+      if (entered) {
+        rmdirSync(inside)
+      }
+    },
+    { staleMs, timeoutMs: staleMs + 20_000, pollMs: 1 },
+  )
+}
+console.log(JSON.stringify({ rounds: Number(roundsArg), overlaps, lostFences }))
