+// changeset.ts: a reader for SQLite session changesets (the binary format of
+// sqlite3session_changeset), used for admission and for the missing-row policy.
+//
+// node:sqlite applies a changeset table that is missing or narrower in the target by
+// skipping it and still reporting success, and its conflict handler receives only the
+// conflict type, never the operation. Reading the table headers lets reconcile refuse an
+// envelope that names a table outside the base set or with another shape, and splitting a
+// changeset by operation lets a delete of a missing row be ignored while an update of a
+// missing row is still reported.
+//
+// Format (sqlite3session.c): a table header is 'T', a varint column count, one primary-key
+// position byte per column, and the NUL-terminated table name. Each change is an operation
+// byte (INSERT 18, UPDATE 23, DELETE 9), an indirect flag byte, and one record (INSERT:
+// new values; DELETE: old values) or two (UPDATE: old, then new). A value is a type byte:
+// 0 undefined, 1 integer and 2 real (8 bytes each), 3 text and 4 blob (a varint length,
+// then the bytes), 5 NULL. A patchset starts its tables with 'P' instead.
+
+import { FsqliteError } from './errors.ts'
+
+export const OP_INSERT = 18
+export const OP_UPDATE = 23
+export const OP_DELETE = 9
+
+const TABLE_CHANGESET = 0x54 // 'T'
+const TABLE_PATCHSET = 0x50 // 'P'
+
+/** One table of a changeset: its name, its column shape, and its change counts. */
+export interface ChangesetTable {
+  name: string
+  columns: number
+  /**
+   * One byte per column: its 1-based position in the primary key, or 0. This is the
+   * `pk` column of `PRAGMA table_info`, which changeset apply compares byte for byte.
+   */
+  primaryKey: number[]
+  inserts: number
+  updates: number
+  deletes: number
+}
+
+/** The parts of a changeset, split by operation, each with its own table headers. */
+export interface SplitChangeset {
+  inserts: Uint8Array
+  updates: Uint8Array
+  deletes: Uint8Array
+}
+
+const malformed = (detail: string): FsqliteError =>
+  new FsqliteError('corrupt', `malformed changeset: ${detail}`)
+
+class Reader {
+  i = 0
+  readonly buf: Uint8Array
+  constructor(buf: Uint8Array) {
+    this.buf = buf
+  }
+
+  byte(): number {
+    const b = this.buf[this.i++]
+    if (b === undefined) {
+      throw malformed('truncated')
+    }
+    return b
+  }
+
+  varint(): number {
+    let v = 0
+    for (let n = 0; n < 9; n++) {
+      const b = this.byte()
+      v = v * 128 + (b & 0x7f)
+      if ((b & 0x80) === 0) {
+        return v
+      }
+    }
+    throw malformed('varint longer than 9 bytes')
+  }
+
+  skipValue(): void {
+    const type = this.byte()
+    if (type === 1 || type === 2) {
+      this.i += 8
+    } else if (type === 3 || type === 4) {
+      const length = this.varint() // read before `this.i`, which varint() advances
+      this.i += length
+    } else if (type !== 0 && type !== 5) {
+      throw malformed(`unknown value type ${type}`)
+    }
+    if (this.i > this.buf.length) {
+      throw malformed('value runs past the end')
+    }
+  }
+}
+
+interface Walk {
+  onTable: (table: ChangesetTable, header: Uint8Array) => void
+  onChange: (op: number, change: Uint8Array) => void
+}
+
+function walk(buf: Uint8Array, visit: Walk): void {
+  const r = new Reader(buf)
+  let table: ChangesetTable | null = null
+  while (r.i < buf.length) {
+    const start = r.i
+    const lead = r.byte()
+    if (lead === TABLE_PATCHSET) {
+      throw malformed('a patchset, not a changeset')
+    }
+    if (lead === TABLE_CHANGESET) {
+      const columns = r.varint()
+      const primaryKey: number[] = []
+      for (let c = 0; c < columns; c++) {
+        primaryKey.push(r.byte())
+      }
+      const nameStart = r.i
+      while (r.byte() !== 0) {
+        // the name runs to its NUL terminator
+      }
+      const name = Buffer.from(buf.subarray(nameStart, r.i - 1)).toString('utf8')
+      table = { name, columns, primaryKey, inserts: 0, updates: 0, deletes: 0 }
+      visit.onTable(table, buf.subarray(start, r.i))
+      continue
+    }
+    if (table === null) {
+      throw malformed('a change before any table header')
+    }
+    r.byte() // the indirect flag
+    const records = lead === OP_UPDATE ? 2 : 1
+    if (lead !== OP_INSERT && lead !== OP_UPDATE && lead !== OP_DELETE) {
+      throw malformed(`unknown operation ${lead}`)
+    }
+    for (let n = 0; n < records; n++) {
+      for (let c = 0; c < table.columns; c++) {
+        r.skipValue()
+      }
+    }
+    if (lead === OP_INSERT) {
+      table.inserts++
+    } else if (lead === OP_UPDATE) {
+      table.updates++
+    } else {
+      table.deletes++
+    }
+    visit.onChange(lead, buf.subarray(start, r.i))
+  }
+}
+
+/** Every table a changeset names, in order, with its shape and change counts. */
+export function changesetTables(buf: Uint8Array): ChangesetTable[] {
+  const tables: ChangesetTable[] = []
+  walk(buf, { onTable: (t) => tables.push(t), onChange: () => undefined })
+  return tables
+}
+
+/**
+ * Split a changeset into three changesets, one per operation, each repeating the table
+ * header before its first change of that table. Within one changeset each row key occurs
+ * at most once, so applying the parts in any order reaches the same rows.
+ */
+export function splitChangesetByOp(buf: Uint8Array): SplitChangeset {
+  const parts: Record<number, Uint8Array[]> = {
+    [OP_INSERT]: [],
+    [OP_UPDATE]: [],
+    [OP_DELETE]: [],
+  }
+  let header: Uint8Array = new Uint8Array(0)
+  let headed = new Set<number>()
+  walk(buf, {
+    onTable: (_table, h) => {
+      header = h
+      headed = new Set()
+    },
+    onChange: (op, change) => {
+      const part = parts[op]!
+      if (!headed.has(op)) {
+        part.push(header)
+        headed.add(op)
+      }
+      part.push(change)
+    },
+  })
+  return {
+    inserts: Buffer.concat(parts[OP_INSERT]!),
+    updates: Buffer.concat(parts[OP_UPDATE]!),
+    deletes: Buffer.concat(parts[OP_DELETE]!),
+  }
+}
