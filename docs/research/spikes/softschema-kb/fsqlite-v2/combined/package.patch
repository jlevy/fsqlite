+test('normalizeMissing defaults to quarantine and rejects unknown settings', () => {
+  assert.deepEqual(
+    { ...normalizeMissing({ t: 'lww' })['*'] },
+    { delete: 'quarantine', update: 'quarantine' },
+  )
+  assert.deepEqual(
+    {
+      ...normalizeMissing({ t: { conflict: 'lww', missingDelete: 'ignore' } }).t,
+    },
+    { delete: 'ignore', update: 'quarantine' },
+  )
+  assert.throws(
+    () =>
+      normalizeMissing({
+        t: { conflict: 'lww', missingDelete: 'drop' as 'ignore' },
+      }),
+    /unknown missingDelete action "drop"/,
+  )
+})
+
+test('changeset admission refuses a table the store lacks or shapes differently', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const store = new SnapshotStore(dir, options()).init()
+    // Forge an envelope captured against another schema: same hashes, other tables.
+    const tx = store.write('w', (db) => {
+      db.exec("INSERT INTO node VALUES ('a', 'A')")
+    })
+    const cs = join(store.txPending, `${tx ?? ''}.txn`, 'changeset.bin')
+    const forged = Buffer.from(
+      readFileSync(cs).toString('latin1').replace('node\u0000', 'nodx\u0000'),
+      'latin1',
+    )
+    writeFileSync(cs, forged)
+    const manifestPath = join(store.txPending, `${tx ?? ''}.txn`, 'manifest.json')
+    const manifest = JSON.parse(readFileSync(manifestPath, 'utf8')) as Record<string, unknown>
+    manifest.changeset_sha256 = createHash('sha256').update(forged).digest('hex')
+    writeFileSync(manifestPath, JSON.stringify(manifest))
+    const result = store.reconcile()
+    assert.equal(result.quarantined, 1)
+    assert.match(
+      String(result.quarantineReasons?.[0]?.[1]),
+      /^admission: table "nodx" is not a caller table/,
+    )
+  } finally {
+    cleanup()
+  }
+})
+
+test('the changeset reader lists tables and splits by operation', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const store = new SnapshotStore(dir, options()).init()
+    store.write('seed', NODES)
+    store.reconcile()
+    const tx = store.write('w', (db) => {
+      db.exec("INSERT INTO node VALUES ('d', 'D')")
+      db.exec("UPDATE node SET label = 'A2' WHERE id = 'a'")
+      db.exec("DELETE FROM edge WHERE source = 'a'")
+    })
+    const cs = readFileSync(join(store.txPending, `${tx ?? ''}.txn`, 'changeset.bin'))
+    const tables = changesetTables(cs).map((t) => [
+      t.name,
+      t.columns,
+      t.primaryKey,
+      t.inserts,
+      t.updates,
+      t.deletes,
+    ])
+    assert.deepEqual(tables.sort(), [
+      ['edge', 3, [1, 2, 0], 0, 0, 2],
+      ['node', 2, [1, 0], 1, 1, 0],
+    ])
+    const parts = splitChangesetByOp(cs)
+    assert.equal(
+      parts.inserts.length + parts.updates.length + parts.deletes.length > cs.length,
+      true,
+    )
+    assert.deepEqual(
+      changesetTables(parts.deletes).map((t) => [t.name, t.deletes]),
+      [['edge', 2]],
+    )
+  } finally {
+    cleanup()
+  }
+})
+
+test('the publisher coalesces pending envelopes and stops when told to', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const store = new SnapshotStore(dir, options()).init()
+    for (let i = 0; i < 25; i++) {
+      store.append('w', 'rows', lines(['node', `n${i}`, String(i)]))
+    }
+    let after = 0
+    const report = store.runPublisher({
+      until: () => true,
+      afterPublish: () => {
+        after++
+      },
+    })
+    assert.equal(report.rounds.length, 1)
+    assert.equal(report.rounds[0]?.result.applied, 25)
+    assert.equal(after, 1)
+    assert.equal(all(store, 'SELECT id FROM node').length, 25)
+  } finally {
+    cleanup()
+  }
+})
