+// fsqlite v2, combined prototype: the seams between Spike 3 (publication and maintenance),
+// Spike 1 (derive at build), and Spike 2 (operation envelopes and the missing-row policy).
+// Each test covers a path that no single spike's suite exercises.
+
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { existsSync, readdirSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import type { DatabaseSync } from 'node:sqlite'
+import { SnapshotStore } from '../src/index.ts'
+import type { ChangedKeys, DerivedSpec, Reducer, StoreOptions } from '../src/index.ts'
+import { tmpStore } from './fixture.ts'
+
+const BASE = `
+  CREATE TABLE node (id TEXT PRIMARY KEY NOT NULL, label TEXT NOT NULL);
+  CREATE TABLE edge (
+    source TEXT NOT NULL,
+    target TEXT NOT NULL,
+    PRIMARY KEY (source, target)
+  ) WITHOUT ROWID;
+  CREATE TABLE redirect (absorbed TEXT PRIMARY KEY NOT NULL, survivor TEXT NOT NULL);
+`
+const DERIVED_DDL = `
+  CREATE INDEX ix_edge_target ON edge (target);
+  CREATE TABLE label_index (label TEXT NOT NULL, id TEXT NOT NULL, PRIMARY KEY (label, id))
+    WITHOUT ROWID;
+`
+
+/** JSON lines: ["node", id, label], ["edge", s, t], ["unnode", id], ["redirect", a, s]. */
+const rows: Reducer = {
+  version: '1',
+  apply(db, payload) {
+    for (const line of Buffer.from(payload).toString('utf8').split('\n')) {
+      if (line === '') {
+        continue
+      }
+      const [kind, a, b] = JSON.parse(line) as [string, string, string]
+      if (kind === 'node') {
+        db.prepare(
+          'INSERT INTO node VALUES (?, ?) ON CONFLICT (id) DO UPDATE SET label = excluded.label',
+        ).run(a, b)
+      } else if (kind === 'edge') {
+        db.prepare('INSERT OR IGNORE INTO edge VALUES (?, ?)').run(a, b)
+      } else if (kind === 'unnode') {
+        db.prepare('DELETE FROM node WHERE id = ?').run(a)
+      } else if (kind === 'redirect') {
+        db.prepare('INSERT OR REPLACE INTO redirect VALUES (?, ?)').run(a, b)
+      } else if (kind === 'derived') {
+        db.prepare("INSERT INTO label_index VALUES ('x', ?)").run(a)
+      }
+    }
+  },
+}
+
+const lines = (...items: unknown[][]): Uint8Array =>
+  Buffer.from(items.map((i) => JSON.stringify(i)).join('\n'))
+
+/** Edges move from an absorbed node to its survivor, from the stored redirect facts. */
+function moveToSurvivors(db: DatabaseSync): Record<string, unknown> {
+  const moved =
+    Number(
+      db
+        .prepare(
+          `UPDATE OR REPLACE edge SET source = (SELECT survivor FROM redirect WHERE absorbed = source)
+           WHERE source IN (SELECT absorbed FROM redirect)`,
+        )
+        .run().changes,
+    ) +
+    Number(
+      db
+        .prepare(
+          `UPDATE OR REPLACE edge SET target = (SELECT survivor FROM redirect WHERE absorbed = target)
+           WHERE target IN (SELECT absorbed FROM redirect)`,
+        )
+        .run().changes,
+    )
+  return { moved }
+}
+
+function derived(seen: string[], closure = true): DerivedSpec {
+  return {
+    version: 1,
+    ddl: DERIVED_DDL,
+    statistics: 'none',
+    rebuild: (db) => {
+      db.exec('INSERT INTO label_index SELECT label, id FROM node')
+    },
+    update: (db, changes: ChangedKeys) => {
+      for (const [table, list] of changes) {
+        for (const row of list) {
+          seen.push(`${table} ${row.op} ${row.key.join('>')}`)
+        }
+      }
+      for (const row of changes.get('node') ?? []) {
+        db.prepare('DELETE FROM label_index WHERE id = ?').run(row.key[0] as string)
