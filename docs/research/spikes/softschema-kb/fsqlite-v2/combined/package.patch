+const SCHEMA = `
+  CREATE TABLE node (id TEXT PRIMARY KEY NOT NULL, label TEXT NOT NULL);
+  CREATE TABLE edge (
+    source TEXT NOT NULL,
+    target TEXT NOT NULL,
+    props TEXT,
+    PRIMARY KEY (source, target)
+  ) WITHOUT ROWID;
+  CREATE INDEX ix_edge_target ON edge (target);
+`
+
+/** A reducer whose payload is JSON lines of `["node", id, label]` or `["edge", s, t]`. */
+const rows: Reducer = {
+  version: '1',
+  apply(db, payload) {
+    for (const line of Buffer.from(payload).toString('utf8').split('\n')) {
+      if (line === '') {
+        continue
+      }
+      const [kind, a, b] = JSON.parse(line) as [string, string, string]
+      if (kind === 'node') {
+        db.prepare(
+          'INSERT INTO node VALUES (?, ?) ON CONFLICT (id) DO UPDATE SET label = excluded.label',
+        ).run(a, b)
+      } else if (kind === 'edge') {
+        db.prepare('INSERT OR REPLACE INTO edge VALUES (?, ?, NULL)').run(a, b)
+      } else if (kind === 'unnode') {
+        db.prepare('DELETE FROM node WHERE id = ?').run(a)
+      } else if (kind === 'throw') {
+        throw new Error('reducer refused the payload')
+      } else if (kind === 'ledger') {
+        db.prepare('DELETE FROM applied_tx').run()
+      }
+    }
+  },
+}
+
+const lines = (...items: unknown[][]): Uint8Array =>
+  Buffer.from(items.map((i) => JSON.stringify(i)).join('\n'))
+
+const options = (extra: Partial<StoreOptions> = {}): StoreOptions => ({
+  schema: SCHEMA,
+  schemaVersion: 1,
+  conflictPolicy: { '*': 'lww' },
+  reducers: { rows },
+  ...extra,
+})
+
+const all = (store: SnapshotStore, sql: string): unknown[] =>
+  store.read((db) =>
+    db
+      .prepare(sql)
+      .all()
+      .map((r) => ({ ...r })),
+  )
+
+test('append commits a single-file envelope that reconcile folds through its reducer once', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    const store = new SnapshotStore(dir, options()).init()
+    const a = store.append('w1', 'rows', lines(['node', 'a', 'A'], ['edge', 'a', 'b']))
+    const b = store.append('w2', 'rows', lines(['node', 'b', 'B']), {
+      durable: true,
+    })
+    assert.deepEqual(store.pendingTxns(), [`${a}.env`, `${b}.env`])
+    const first = store.reconcile()
+    assert.equal(first.applied, 2)
+    assert.deepEqual(first.appliedTxIds, [a, b])
+    assert.deepEqual(all(store, 'SELECT id, label FROM node ORDER BY id'), [
+      { id: 'a', label: 'A' },
+      { id: 'b', label: 'B' },
+    ])
+    assert.equal(
+      store.read(
+        (db) =>
+          (
+            db.prepare("SELECT value FROM fsqlite_meta WHERE key = 'reducer.rows'").get() as {
+              value: string
+            }
+          ).value,
+      ),
+      '1',
+    )
+    // Exactly once: an envelope copied back into pending is found in the ledger.
+    writeFileSync(
+      join(store.txPending, `${a}.env`),
+      readFileSync(join(store.txApplied, `${a}.env`)),
