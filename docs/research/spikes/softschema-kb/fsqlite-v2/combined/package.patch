+    store.append('w1', 'rows', lines(['edge', 'a', 'b']))
+    // A merge of b into c that knows nothing of the edge: it only deletes b and records
+    // the redirect fact. Without the closure, the cascade relation would delete a>b.
+    store.append('w2', 'rows', lines(['unnode', 'b'], ['redirect', 'b', 'c']))
+    const first = store.reconcile()
