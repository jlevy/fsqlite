+      db.exec("DELETE FROM node WHERE id = 'b'")
+    })
+    assert.equal(store.reconcile().quarantined, 0)
+    // union keeps the first writer's row: the delete of a changed row is omitted.
+    assert.deepEqual(all(store, "SELECT label FROM node WHERE id = 'b'"), [{ label: 'B2' }])
+  } finally {
+    cleanup()
+  }
+})
