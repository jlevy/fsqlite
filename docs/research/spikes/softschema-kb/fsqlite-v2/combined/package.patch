+test('the closure hook runs inside the build after the envelopes, and a failure publishes nothing', () => {
+  const { dir, cleanup } = tmpStore()
+  try {
+    let fail = false
+    const seenByUpdate: string[] = []
+    // Combined prototype: the closure is the derived specification's hook, run before the
+    // cascade relations and the derived update, which sees the rows the closure changed.
+    const closure = (db: DatabaseSync): Record<string, unknown> => {
+      if (fail) {
