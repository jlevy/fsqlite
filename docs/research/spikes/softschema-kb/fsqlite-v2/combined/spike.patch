+#!/usr/bin/env bash
+# fsqlite v2 combined prototype (spikes 3, 1, and 2): the correctness checks at a round-2
+# scale. No timing is claimed from these runs.
+#
+# Usage: fsqlite/run_combined.sh S1-r2
+#
+# Results go to results/$KB_RESULTS_ARM/<scale>/ (default fsqlite-v2/combined). Working
+# stores go to $KB_SCRATCH/fsqlite-spike/<scale> and are deleted at the end.
+set -euo pipefail
+
+SCALE=${1:?usage: run_combined.sh <round-2 scale>}
+HERE=$(cd "$(dirname "$0")" && pwd)
+: "${KB_SCRATCH:?set KB_SCRATCH to the scratch directory that holds kb-corpora/}"
+export KB_RESULTS_ARM=${KB_RESULTS_ARM:-fsqlite-v2/combined}
+export KB_COPY_PROBE=0 KB_V2_MISSING=none
+WORK=$KB_SCRATCH/fsqlite-spike/$SCALE
+BASE=$WORK/store-direct
+DELTAS=$KB_SCRATCH/kb-corpora/$SCALE/deltas
+NODE=(node --disable-warning=ExperimentalWarning)
+cd "$HERE"
+
+w2() { # variant strategy
+  local variant=$1 strategy=$2
+  "${NODE[@]}" w2.ts "$BASE" --scale "$SCALE" --deltas "$DELTAS" --strategy "$strategy" \
+    --variant "$variant" --batches p05,p20
+}
+
+# W1 through DirectStore (derived objects built after the rows), then W3 v2 twice: the
+# substring scan with live facets, and the in-file FTS5 index with the facet summary.
+"${NODE[@]}" w1.ts --scale "$SCALE" --validate --routes direct
+"${NODE[@]}" w3.ts "$BASE" --scale "$SCALE"
+"${NODE[@]}" w3.ts "$BASE" --scale "$SCALE" --name w3-fts --fts-inline --facet-summary
+# Four writers appending operation envelopes. `ops` is the facts reducer; `ops-naive` has
+# no base facts, so the closure in the build must move merged edges; KB_V2_CLOSURE=0 keeps
+# only Spike 1's cascade relations, which delete those edges instead.
+w2 ops ops
+w2 ops-naive-closure ops-naive
+KB_V2_CLOSURE=0 w2 ops-naive-relations-only ops-naive
+# W6: the publication kill point and its recovery.
+"${NODE[@]}" w6.ts --scale "$SCALE" --phases publication
+
+rm -rf "$WORK"
