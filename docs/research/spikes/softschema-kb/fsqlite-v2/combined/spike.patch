+#!/usr/bin/env bash
+# fsqlite v2 Spike 2: cheap capture and serial apply, at one scale.
+#
+# Usage: fsqlite/run_spike2.sh S1-r2|S2-r2 [reps]   # four writers on v2 batches (H2, H3, H4)
+#        fsqlite/run_spike2.sh S1|S2 [reps]         # trickle capture and sustained (H1, H5)
+#
+# The base store must exist at $KB_SCRATCH/fsqlite-spike/<scale>/store-direct (w1.ts
+# --routes direct). Results go to results/$KB_RESULTS_ARM/<scale>/.
+set -euo pipefail
+
+SCALE=${1:?usage: run_spike2.sh <scale> [reps]}
+REPS=${2:-3}
+HERE=$(cd "$(dirname "$0")" && pwd)
+: "${KB_SCRATCH:?set KB_SCRATCH to the scratch directory that holds kb-corpora/}"
+export KB_RESULTS_ARM=${KB_RESULTS_ARM:-fsqlite-v2/spike2}
+WORK=$KB_SCRATCH/fsqlite-spike/$SCALE
+BASE=$WORK/store-direct
+DELTAS=$KB_SCRATCH/kb-corpora/$SCALE/deltas
+NODE=(node --disable-warning=ExperimentalWarning)
+cd "$HERE"
+
+w2() { # variant strategy missing closure [extra flags]
+  local variant=$1 strategy=$2 missing=$3 closure=$4
+  shift 4
+  KB_V2_MISSING=$missing KB_V2_CLOSURE=$closure "${NODE[@]}" w2.ts "$BASE" --scale "$SCALE" \
+    --deltas "$DELTAS" --strategy "$strategy" --variant "$variant" "$@"
+}
+
+case "$SCALE" in
+*-r2)
+  # H2, H3: operation envelopes, the serial reducer with base facts, closure in the build.
+  w2 ops ops none 1 --reps "$REPS"
+  # Ablation: a reducer without base facts, without and with the closure.
+  w2 ops-naive ops-naive none 0
+  w2 ops-naive-closure ops-naive none 1
+  # H4: changeset envelopes with idempotent deletes and no closure, then with the closure.
+  w2 sparse-missingdelete sparse delete 0
+  w2 sparse-missingdelete-closure sparse delete 1
+  if [ "${FULL_CAPTURE:-0}" = 1 ]; then
+    w2 full-missingdelete snapshot delete 0
+  fi
+  # One writer in line order: DirectStore (the H2 reference) and one operation envelope.
+  KB_V2_MISSING=none KB_V2_CLOSURE=1 "${NODE[@]}" w2v2.ts "$BASE" --scale "$SCALE" \
+    --arms DirectStore,Append --batches p01,p05,p20 --batch-reps "$REPS" --name w2-v2-one-writer
+  ;;
+*)
+  # H1 and H5: one-record to 100-record captures through each capture path, then the
+  # sustained trickle through the coalescing publisher.
+  KB_V2_MISSING=none KB_V2_CLOSURE=0 "${NODE[@]}" trickle.ts "$BASE" --scale "$SCALE" \
+    --delta "$DELTAS/p20" --reps "$REPS" --arms SnapshotStore,Sparse,Ops --skip-sustained \
+    --name w2-trickle-capture
+  for strategy in ops sparse; do
+    KB_V2_MISSING=none KB_V2_CLOSURE=0 "${NODE[@]}" trickle.ts "$BASE" --scale "$SCALE" \
+      --delta "$DELTAS/p20" --skip-batches --strategy "$strategy" \
+      --rate "${TRICKLE_RATE:-200}" --seconds "${TRICKLE_SECONDS:-30}" \
+      --name "w2-trickle-sustained-$strategy"
+  done
+  ;;
+esac
