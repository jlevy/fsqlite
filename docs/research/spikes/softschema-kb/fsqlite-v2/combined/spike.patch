+    done
+    ;;
+  *)
+    "${NODE[@]}" w1.ts --scale "$SCALE" --routes direct
+    rm -f "$WORK/rows.jsonl"
+    "${NODE[@]}" w3.ts "$WORK/store-direct" --scale "$SCALE"
+    "${NODE[@]}" w3.ts "$WORK/store-direct" --scale "$SCALE" --name w3-fts --fts-inline --facet-summary
+    "${NODE[@]}" plans.ts "$WORK/store-direct" --scale "$SCALE"
+    "${NODE[@]}" trickle.ts "$WORK/store-direct" --scale "$SCALE" --delta "$DELTAS/p20" \
+      --seconds "${TRICKLE_SECONDS:-20}" --reps "${TRICKLE_REPS:-3}"
+    "${NODE[@]}" w4.ts --scale "$SCALE" --cases string_to_object --skip-typed --name w4-case5
+    ;;
+esac
+
+rm -rf "$WORK"
