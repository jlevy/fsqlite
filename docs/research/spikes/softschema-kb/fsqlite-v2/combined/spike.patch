+// v2 Spike 1 (H3): publish a new view index in the same store, several times, by bumping the
+// derived version with alternating view definitions. Each publish is one reconcile with no
+// pending envelopes; gc({ retain: 0 }) follows, then a warm per-table quick_check of the new
+// head separates a cold gate from the build.
+//
+// Usage: node h3.ts <store-dir> --scale S2-r2 [--reps 3]
+// Writes results/fsqlite-v2/spike1/<scale>/w4-case5-repeat.json.
+
+import { DatabaseSync } from 'node:sqlite'
+import { SnapshotStore, readStoreMarker } from './fsq.ts'
+import { isMain, nowMs, parseArgs, round, writeResult } from './common.ts'
+import { BUILDS, GENERIC_DERIVED_VERSION, TABLE_VIEWS, genericOptions, genericPlans } from './mapping.ts'
+import { openReader } from './w3.ts'
+
+const LOCK = { lockOpts: { timeoutMs: 600_001, staleMs: 600_000 } }
+
+function warmTableCheckMs(path: string): number {
+  const db = new DatabaseSync(path, { readOnly: true })
+  try {
+    const tables = (db.prepare('PRAGMA main.table_list').all() as { name: string; type: string }[])
+      .filter((r) => (r.type === 'table' || r.type === 'shadow') && r.name !== 'sqlite_schema')
+      .map((r) => r.name)
+    const t = nowMs()
+    for (const name of tables) {
+      db.prepare(`PRAGMA main.quick_check("${name}")`).all()
+    }
+    return round(nowMs() - t)
+  } finally {
+    db.close()
+  }
+}
+
+function main(): void {
+  const { flags, args } = parseArgs(process.argv.slice(2))
+  const dir = args[0] ?? ''
+  const scale = flags.scale ?? 'S2-r2'
+  const reps = Number(flags.reps ?? 3)
+  const id = readStoreMarker(dir).store_id
+  const variants = [
+    TABLE_VIEWS.map((v) =>
+      v.name === 'repos_by_stars' ? { ...v, filter: "payload ->> '$.primary_language.name'" } : v,
+    ),
+    TABLE_VIEWS,
+  ]
+  const runs = []
+  for (let r = 0; r < reps; r++) {
+    const views = variants[r % 2] ?? TABLE_VIEWS
+    // The variant's filter is NULL on these string-valued payloads, so its total assertion
+    // is left out; the page assertions stay.
+    const plans = genericPlans(views).filter((p) => r % 2 === 1 || !p.name.endsWith('total'))
+    const version = GENERIC_DERIVED_VERSION + 1 + r
+    const t0 = nowMs()
+    const store = new SnapshotStore(dir, genericOptions({ views, derivedVersion: version, plans })).init()
+    const res = store.reconcile(LOCK)
+    const publishMs = nowMs() - t0
+    const build = BUILDS.at(-1)
+    const head = store.snapshotPath(store.currentVersion())
+    const tGc = nowMs()
+    store.gc({ retain: 0 })
+    const gcMs = nowMs() - tGc
+    const db = openReader(head)
+    const plan = (
+      db
+        .prepare(
+          `EXPLAIN QUERY PLAN SELECT id FROM entity INDEXED BY ix_view_repos_by_stars
+           WHERE kind = 'repository' AND ${views.find((v) => v.name === 'repos_by_stars')?.filter} = ?
+           ORDER BY payload ->> '$.stars' DESC, id LIMIT 50`,
+        )
+        .all('Python') as { detail: string }[]
+    ).map((x) => x.detail)
+    db.close()
+    runs.push({
+      derived_version: version,
+      published: res.published,
+      publish_ms: round(publishMs),
+      build_index_ms: build?.derive_ms,
+      statistics_ms: build?.statistics_ms,
+      gate: build?.gate,
+      gate_ms: build?.gate_ms,
+      hook_ms: build?.hook_ms,
+      created: build?.createdObjects,
+      dropped: build?.droppedObjects,
+      warm_table_check_after_ms: warmTableCheckMs(head),
+      gc_ms: round(gcMs),
+      plan,
+      store_id_unchanged: readStoreMarker(dir).store_id === id,
+    })
+  }
+  const sorted = (k: string) =>
+    runs.map((x) => Number((x as Record<string, unknown>)[k])).sort((a, b) => a - b)
+  const median = (k: string) => sorted(k)[Math.floor((runs.length - 1) / 2)]
+  console.log(
+    writeResult(scale, 'w4-case5-repeat', {
+      workflow: 'W4 case 5 (view index change) as a derived version bump, repeated',
+      reps: runs.length,
+      publish_ms_median: median('publish_ms'),
+      gate_ms_median: median('gate_ms'),
+      build_index_ms_median: median('build_index_ms'),
+      warm_table_check_after_ms_median: median('warm_table_check_after_ms'),
+      runs,
+    }),
+  )
+}
+
+if (isMain(import.meta.url)) {
+  main()
+}
