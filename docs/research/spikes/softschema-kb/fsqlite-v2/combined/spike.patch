+// fsqlite v2 Spike 2: the knowledge-base side of operation envelopes (design (k)), sparse
+// capture (l), the missing-row policy (n), and closure in the build (section 3.6).
+//
+// - `kb-delta` v2 is the serial reducer: an operation envelope's payload is intermediate
+//   JSONL rows (the delta-v2 `op` rows and the rows each writes, plus the node rows they
+//   reference), and the reducer feeds them to one GenericLoader per build, started from the
+//   stored tombstones and redirects, so envelope order resolves endpoints like line order.
+// - `kb-delta-naive` v1 is the ablation: a fresh loader per envelope that knows only its
+//   own envelope's deletes and merges, which is what a reducer without base facts sees.
+// - `kbClosure` runs inside every build after the envelopes: it removes edges incident to
+//   tombstoned ids and moves edges of absorbed ids to their survivors, so the published
+//   graph has no edge to a deleted or absorbed node whatever order the envelopes arrived
+//   in. Combined v2: it is the `closure` hook of Spike 1's derived specification
+//   (mapping.ts), which runs it before the cascade relations, under a session, so the rows
+//   it moves reach the derived update as changed keys.
+// - `hydrateRows` is the sparse-capture hydration plan for the same rows.
+//
+// The store configuration comes from the environment, so every process of a run (writers,
+// reader, reconciler) opens the store the same way:
+//   KB_V2_MISSING   none | delete | delete,update  (missingDelete / missingUpdate: ignore)
+//   KB_V2_CLOSURE   0 to leave kbClosure out of the derived specification (combined v2:
+//                   it runs in every build by default, before Spike 1's cascade relations)
+
+import type { DatabaseSync } from 'node:sqlite'
+import type { ConflictPolicyInput, HydrateCopy, Reducer, StoreOptions } from './fsq.ts'
+import type { KbRow, NodeRow } from './common.ts'
+import { GENERIC_POLICY, GenericLoader, TYPED_REF } from './mapping.ts'
+
+export const KB_REDUCER = 'kb-delta'
+export const KB_REDUCER_NAIVE = 'kb-delta-naive'
+
+function rowsOf(payload: Uint8Array): KbRow[] {
+  const text = Buffer.from(payload.buffer, payload.byteOffset, payload.byteLength).toString('utf8')
+  const rows: KbRow[] = []
+  for (const line of text.split('\n')) {
+    if (line !== '') {
+      rows.push(JSON.parse(line) as KbRow)
+    }
+  }
+  return rows
+}
+
+/** The serial reducer: one loader per build, seeded with the stored base facts. */
+export const kbReducer: Reducer = {
+  version: '2',
+  apply(db, payload, ctx) {
+    let loader = ctx.build.get('kb-loader') as GenericLoader | undefined
+    if (!loader) {
+      loader = new GenericLoader(db, false, { facts: true })
+      ctx.build.set('kb-loader', loader)
+    }
+    for (const row of rowsOf(payload)) {
+      loader.add(row)
+    }
+  },
+}
+
+/** The ablation: a fresh loader per envelope, with no memory of other envelopes. */
+export const kbReducerNaive: Reducer = {
+  version: '1',
+  apply(db, payload) {
+    const loader = new GenericLoader(db)
+    for (const row of rowsOf(payload)) {
+      loader.add(row)
+    }
+  },
+}
+
+// Edges incident to a tombstoned or absorbed id. The IN forms keep the planner on the edge
+// indexes: without statistics, a join from the fact table scans every edge instead.
+const GONE = '(SELECT id FROM kb_tombstone UNION ALL SELECT absorbed FROM kb_redirect)'
+const DANGLING_FACTS = `
+  SELECT (SELECT count(*) FROM edge WHERE source IN ${GONE})
+       + (SELECT count(*) FROM edge WHERE target IN ${GONE} AND source NOT IN ${GONE})
+    AS n`
+
+/**
+ * Closure in the build: remove edges incident to tombstoned ids, then replay every stored
+ * redirect as a merge, which moves the edges still incident to an absorbed id to its
+ * survivor and rewrites their origin. Both are idempotent and driven by the base facts.
+ */
+export function kbClosure(db: DatabaseSync): Record<string, unknown> {
+  const t0 = performance.now()
+  const before = (db.prepare(DANGLING_FACTS).get() as { n: number }).n
+  let removed = 0
+  let moved = 0
+  if (before > 0) {
+    removed += Number(
+      db.prepare('DELETE FROM edge WHERE source IN (SELECT id FROM kb_tombstone)').run().changes,
+    )
+    removed += Number(
+      db.prepare('DELETE FROM edge WHERE target IN (SELECT id FROM kb_tombstone)').run().changes,
+    )
+    const redirects = db
+      .prepare(
+        `SELECT absorbed, survivor, absorbed_path, survivor_path FROM kb_redirect r
+         WHERE EXISTS (SELECT 1 FROM edge g WHERE g.source = r.absorbed)
+            OR EXISTS (SELECT 1 FROM edge g WHERE g.target = r.absorbed)`,
+      )
+      .all() as {
+      absorbed: string
+      survivor: string
+      absorbed_path: string
+      survivor_path: string
+    }[]
+    if (redirects.length > 0) {
+      const loader = new GenericLoader(db, false, { facts: true })
+      for (const r of redirects) {
+        const n = (
+          db
+            .prepare('SELECT count(*) AS n FROM edge WHERE source = ?1 OR target = ?1')
+            .get(r.absorbed) as { n: number }
+        ).n
+        moved += n
+        loader.add({ t: 'op', op: 'merge', ...r })
+      }
+    }
+  }
+  const after = (db.prepare(DANGLING_FACTS).get() as { n: number }).n
+  return {
+    edges_on_deleted_or_absorbed_before: before,
+    removed,
+    moved,
+    edges_on_deleted_or_absorbed_after: after,
+    ms: Math.round((performance.now() - t0) * 1000) / 1000,
+  }
+}
+
+/** The store options a run's environment selects: reducers and the missing-row policy. */
+export function v2StoreOptions(): Partial<StoreOptions> {
+  const missing = (process.env.KB_V2_MISSING ?? 'none').split(',')
+  const table = {
+    conflict: 'lww' as const,
+    ...(missing.includes('delete') ? { missingDelete: 'ignore' as const } : {}),
+    ...(missing.includes('update') ? { missingUpdate: 'ignore' as const } : {}),
+  }
+  const policy: ConflictPolicyInput = missing.some((m) => m === 'delete' || m === 'update')
+    ? Object.fromEntries(Object.keys(GENERIC_POLICY).map((t) => [t, table]))
+    : { ...GENERIC_POLICY }
+  return {
+    conflictPolicy: policy,
+    reducers: { [KB_REDUCER]: kbReducer, [KB_REDUCER_NAIVE]: kbReducerNaive },
+  }
+}
+
+/** Every typed reference a JSON payload text names, for display-name hydration. */
+function refsIn(text: string): string[] {
+  const out: string[] = []
+  for (const m of text.matchAll(/"([a-z]+:[a-z0-9][a-z0-9._/@+-]*)"/g)) {
+    if (m[1] && TYPED_REF.test(m[1])) {
+      out.push(m[1])
+    }
+  }
+  return out
+}
+
+/**
+ * The node rows a set of rows needs for display names: every batch node named by an edge
+ * endpoint or by a typed reference in a payload. Over-inclusion is harmless.
+ */
+export function referencedNodes(rows: KbRow[], nodes: Map<string, NodeRow>): NodeRow[] {
+  const ids = new Set<string>()
+  for (const row of rows) {
+    if (row.t === 'entity') {
+      ids.add(row.id)
+      for (const ref of refsIn(row.payload)) {
+        ids.add(ref)
+      }
+    } else if (row.t === 'edge') {
+      ids.add(row.source)
+      ids.add(row.target)
+    }
+  }
+  return [...ids].flatMap((id) => {
+    const node = nodes.get(id)
+    return node ? [node] : []
+  })
+}
+
+/**
+ * The sparse-capture hydration plan for intermediate rows: every head row the loader will
+ * read, update, or delete for them (design (l): the API hydrates through a helper rather
+ * than relying on the callback).
+ */
+export function hydrateRows(rows: KbRow[]): (db: DatabaseSync, copy: HydrateCopy) => void {
+  return (_db, copy) => {
+    copy('kb_tombstone', '1')
+    copy('kb_redirect', '1')
+    const entity = (id: string): void => {
+      copy('entity', 'id = ?', id)
+      copy('search_text', 'id = ?', id)
+    }
+    const incident = (id: string): void => {
+      copy('edge', 'source = ?', id)
+      copy('edge', 'target = ?', id)
+    }
+    const byOrigin = (path: string): void => {
+      copy('edge', "props ->> '$.origin' = ?", path)
+    }
+    for (const row of rows) {
+      switch (row.t) {
+        case 'op':
+          if (row.op === 'merge') {
+            entity(row.absorbed)
+            incident(row.absorbed)
+            incident(row.survivor)
+            byOrigin(row.absorbed_path)
+            copy('doc', 'path = ?', row.absorbed_path)
+          } else {
+            for (const id of row.node_ids) {
+              entity(id)
+              if (row.op === 'delete') {
+                incident(id)
+              }
+            }
+            byOrigin(row.path)
+            copy('doc', 'path = ?', row.path)
+          }
+          break
+        case 'entity':
+          entity(row.id)
+          for (const ref of refsIn(row.payload)) {
+            copy('entity', 'id = ?', ref)
+          }
+          break
+        case 'doc':
+          copy('doc', 'path = ?', row.path)
+          break
+        case 'edge':
+          if (row.ord === null) {
+            copy(
+              'edge',
+              'source = ? AND relation = ? AND target = ?',
+              row.source,
+              row.relation,
+              row.target,
+            )
+          } else {
+            copy(
+              'edge',
+              'source = ? AND relation = ? AND target = ? AND ord = ?',
+              row.source,
+              row.relation,
+              row.target,
+              row.ord,
+            )
+          }
+          break
+        default:
+          break
+      }
+    }
+  }
+}
