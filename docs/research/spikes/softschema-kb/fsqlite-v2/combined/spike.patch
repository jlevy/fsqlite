 export const GENERIC_SCHEMA_VERSION = 1
 
+// ---------------------------------------------------------------------------------------
+// fsqlite v2 Spike 1: the same mapping split into base tables (the changeset contract) and
+// derived objects that every generation build maintains (indexes, an FTS5 trigram index,
+// a facet summary, statistics), plus closure relations and plan assertions.
+
+/** The base tables only: what envelopes carry and the schema hash covers. */
+export function baseDdl(): string {
+  return genericDdl()
+    .split('\n')
+    .filter((line) => !line.startsWith('CREATE INDEX'))
+    .join('\n')
+}
+
+/** Derived objects: every secondary index, the in-file search index, the facet summary. */
+export function derivedDdl(views: readonly TableView[] = TABLE_VIEWS): string {
+  const indexes = genericDdl(views)
+    .split('\n')
+    .filter((line) => line.startsWith('CREATE INDEX'))
+  return [
+    ...indexes,
+    // Search: a contentless trigram index whose rowids map to search_text keys.
+    'CREATE TABLE search_doc (docid INTEGER PRIMARY KEY, id TEXT NOT NULL, r INTEGER NOT NULL, UNIQUE (id, r));',
+    "CREATE VIRTUAL TABLE search_fts USING fts5(text, content = '', contentless_delete = 1, tokenize = 'trigram');",
+    // Facets: distinct sources per (relation, source kind, target).
+    `CREATE TABLE facet_count (relation TEXT NOT NULL, target TEXT NOT NULL, source_kind TEXT NOT NULL,
+  n INTEGER NOT NULL, PRIMARY KEY (relation, target, source_kind)) WITHOUT ROWID;`,
+    'CREATE INDEX ix_facet_top ON facet_count (relation, source_kind, n DESC, target);',
+  ].join('\n')
+}
+
+const FACET_GROUP = `INSERT INTO facet_count (relation, target, source_kind, n)
+  SELECT g.relation, g.target, s.kind, count(DISTINCT g.source)
+  FROM edge g JOIN entity s ON s.id = g.source`
+
+/** Fill the derived tables from the base tables (they are empty when this runs). */
+function rebuildDerived(db: DatabaseSync): void {
+  db.exec(`
+    INSERT INTO search_doc (id, r) SELECT id, rank FROM search_text ORDER BY id, rank;
+    INSERT INTO search_fts (rowid, text)
+      SELECT d.docid, s.text FROM search_doc d JOIN search_text s ON s.id = d.id AND s.rank = d.r
+      ORDER BY d.docid;
+    INSERT INTO search_fts (search_fts) VALUES ('optimize');
+    ${FACET_GROUP} GROUP BY g.relation, g.target, s.kind;
+  `)
+}
+
+/** Bring the search index and the facet summary up to date for the changed base rows. */
+function updateDerived(db: DatabaseSync, changes: ChangedKeys): void {
+  const ids = new Set<string>()
+  for (const table of ['search_text', 'entity']) {
+    for (const r of changes.get(table) ?? []) {
+      ids.add(String(r.key[0]))
+    }
+  }
+  if (ids.size > 0) {
+    const docs = db.prepare('SELECT docid FROM search_doc WHERE id = ?')
+    const ftsDelete = db.prepare('DELETE FROM search_fts WHERE rowid = ?')
+    const docDelete = db.prepare('DELETE FROM search_doc WHERE id = ?')
+    const docInsert = db.prepare(
+      'INSERT INTO search_doc (id, r) SELECT id, rank FROM search_text WHERE id = ? ORDER BY rank',
+    )
+    const ftsInsert = db.prepare(
+      `INSERT INTO search_fts (rowid, text) SELECT d.docid, s.text FROM search_doc d
+       JOIN search_text s ON s.id = d.id AND s.rank = d.r WHERE d.id = ? ORDER BY d.docid`,
+    )
+    for (const id of [...ids].sort()) {
+      for (const d of docs.all(id) as { docid: number }[]) {
+        ftsDelete.run(d.docid)
+      }
+      docDelete.run(id)
+      docInsert.run(id)
+      ftsInsert.run(id)
+    }
+  }
+  // Facet groups: every (relation, target) a changed edge names, and every group a changed
+  // entity is a source of (its kind may have changed).
+  const groups = new Set<string>()
+  for (const r of changes.get('edge') ?? []) {
+    groups.add(JSON.stringify([r.key[1], r.key[2]]))
+  }
+  const out = db.prepare('SELECT DISTINCT relation, target FROM edge WHERE source = ?')
+  for (const r of changes.get('entity') ?? []) {
+    for (const g of out.all(r.key[0] as string) as { relation: string; target: string }[]) {
+      groups.add(JSON.stringify([g.relation, g.target]))
+    }
+  }
+  if (groups.size > 0) {
+    const drop = db.prepare('DELETE FROM facet_count WHERE relation = ? AND target = ?')
+    const add = db.prepare(`${FACET_GROUP} WHERE g.relation = ? AND g.target = ? GROUP BY s.kind`)
+    for (const g of [...groups].sort()) {
+      const [relation, target] = JSON.parse(g) as [string, string]
+      drop.run(relation, target)
+      add.run(relation, target)
+    }
+  }
+}
+
+/** The view page as W3 runs it, for a plan assertion. */
+function viewPageSql(v: TableView, hinted: boolean): string {
+  const from = hinted ? `entity INDEXED BY ix_view_${v.name}` : 'entity'
+  return `SELECT id, label, ${v.value} AS value FROM ${from} WHERE kind = '${v.kind}'${
+    v.filter ? ` AND ${v.filter} = ?` : ''
+  } ORDER BY ${v.sort}${v.descending ? ' DESC' : ''}, id LIMIT ? OFFSET ?`
+}
+
+export const HUB_JOIN_UNHINTED = `SELECT e.id, e.label FROM (SELECT DISTINCT source FROM edge
+  WHERE target = ? AND relation = 'affiliated_with') m
+  CROSS JOIN entity e ON e.id = m.source WHERE e.kind = 'person' ORDER BY e.label, e.id LIMIT ? OFFSET ?`
+
+/**
+ * Plans every build asserts: the W3 view pages, each filtered view's total (W3 does not pin
+ * it, and sampled statistics moved it off its index), and the people-by-org join with no hint.
+ */
+export function genericPlans(views: readonly TableView[] = TABLE_VIEWS): PlanAssertion[] {
+  return [
+    ...views.map((v) => ({
+      name: `view ${v.name}`,
+      sql: viewPageSql(v, true),
+      uses: `ix_view_${v.name}`,
+    })),
+    ...views
+      .filter((v) => v.filter !== null)
+      .map((v) => ({
+        name: `view ${v.name} total`,
+        sql: `SELECT count(*) AS n FROM entity WHERE kind = '${v.kind}' AND ${v.filter} = ?`,
+        uses: `ix_view_${v.name}`,
+      })),
+    {
+      name: 'people_by_org join without a hint',
+      sql: HUB_JOIN_UNHINTED,
+      uses: ['ix_entity_id_kind', 'sqlite_autoindex_entity_1'],
+    },
+  ]
+}
+
+/** The unfiltered view page without INDEXED BY: statistics do not fix its plan (A.8). */
+export function unhintedViewPlan(): PlanAssertion {
+  const v = TABLE_VIEWS.find((x) => x.name === 'repos_all_by_stars') as TableView
+  return { name: 'repos_all_by_stars without INDEXED BY', sql: viewPageSql(v, false), uses: 'ix_view_repos_all_by_stars' }
+}
+
+export const GENERIC_DERIVED_VERSION = 1
+
+export function genericDerived(
+  views: readonly TableView[] = TABLE_VIEWS,
+  version = GENERIC_DERIVED_VERSION,
+  plans: PlanAssertion[] = genericPlans(views),
+): DerivedSpec {
+  return {
+    version,
+    ddl: derivedDdl(views),
+    rebuild: rebuildDerived,
+    update: updateDerived,
+    statistics: 'optimize',
+    analysisLimit: Number(process.env.FSQ_ANALYSIS_LIMIT ?? 0),
+    plans,
+    rebuildAboveRatio: Number(process.env.FSQ_REBUILD_RATIO ?? 0.5),
+    // Combined v2: the closure runs in every build before the cascade relations below. It
+    // moves edges of an absorbed id to its survivor and drops edges of a tombstoned id,
+    // from the stored facts, so a merge's edges move instead of being deleted.
+    // KB_V2_CLOSURE=0 leaves only the relations (Spike 1's closure), for an ablation.
+    ...(process.env.KB_V2_CLOSURE === '0' ? {} : { closure: kbClosure }),
+  }
+}
+
+/**
+ * Cascade relations: an edge whose endpoint a build deleted goes. In the combined prototype
+ * they run after the closure hook, which has already moved a merge's edges to the survivor,
+ * so they remove only edges of a node that is deleted and not redirected.
+ */
