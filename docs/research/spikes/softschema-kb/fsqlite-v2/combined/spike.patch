+"""Headline tables for fsqlite v2 Spike 2, from results/fsqlite-v2/spike2/<scale>/.
+
+Usage: python3 fsqlite/summary_spike2.py [S1-r2 S2-r2 S1 S2]
+
+Baselines come from results/fsqlite/<scale>/ (round 1 and round 2 of the spike), or from
+$KB_BASELINE_RESULTS/<scale>/.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import statistics
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent / "results"
+V2 = ROOT / "fsqlite-v2" / "spike2"
+# The round-1 and round-2 baselines; KB_BASELINE_RESULTS points elsewhere for a scratch copy.
+BASE = Path(os.environ.get("KB_BASELINE_RESULTS", ROOT / "fsqlite"))
+
+
+def load(path: Path) -> dict | None:
+    return json.loads(path.read_text()) if path.exists() else None
+
+
+def med(values: list[float]) -> float | None:
+    values = [v for v in values if v is not None]
+    return round(statistics.median(values), 1) if values else None
+
+
+def by_batch(doc: dict | None) -> dict[str, list[dict]]:
+    out: dict[str, list[dict]] = {}
+    for b in (doc or {}).get("batches", []):
+        out.setdefault(b["batch"], []).append(b)
+    return out
+
+
+def one_writer(scale: str) -> dict[str, dict[str, float | None]]:
+    """Median one-writer visible ms per batch: this run's DirectStore and Append, and round 2's."""
+    mine = load(V2 / scale / "w2-v2-one-writer.json") or {"results": {}}
+    base = load(BASE / scale / "w2-v2.json") or {"results": {}}
+    out = {}
+    # w2v2.ts reports the lower of two runs as its median, so take the median of the runs.
+    def runs_median(arm: dict | None, key: str) -> float | None:
+        return med([r.get(key) for r in (arm or {}).get("runs", [])])
+
+    for name in ("p01", "p05", "p20"):
+        arms = mine["results"].get(name, {}).get("arms", {})
+        out[name] = {
+            "direct": runs_median(arms.get("DirectStore"), "visible_ms"),
+            "direct_n": (arms.get("DirectStore") or {}).get("reps"),
+            "append": runs_median(arms.get("Append"), "visible_ms"),
+            "append_reconcile": runs_median(arms.get("Append"), "reconcile_ms"),
+            "round2_direct": base["results"].get(name, {}).get("arms", {}).get("DirectStore", {}).get("visible_ms"),
+            "same_rows": mine["results"].get(name, {}).get("same_rows_across_arms"),
+        }
+    return out
+
+
+def four_writers(scale: str) -> None:
+    ref = one_writer(scale)
+    base = by_batch(load(BASE / scale / "w2.json"))
+    print(f"\n## {scale}: four writers (H2, H3, H4)\n")
+    print("| Variant | Batch | Runs | Visible ms (median) | Ratio to this run's 1-writer DirectStore | Ratio to round 2's | Capture p50 ms | Reconcile ms | Quarantined | Missing omitted | Closure removed/moved | Dangling after publish | Rows equal line order | W3 after p05 |")
+    print("| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
+    for name, runs in base.items():
+        b = runs[0]
+        r = b["reconcile"] or {}
+        direct = ref[name]["round2_direct"]
+        print(
+            f"| round 2 (f1.0, repair) | {name} | 1 | {b['visible_after_ms']} | n/a | "
+            f"{round(b['visible_after_ms'] / direct, 2) if direct else 'n/a'} | {b['capture_ms']['p50_ms']} | "
+            f"{r.get('ms')} | {r.get('quarantined')} | n/a | n/a | {(r.get('closure') or {}).get('dangling_edges_before')} (before repair) | "
+            f"{(b.get('same_rows_as_one_writer_in_line_order') or {}).get('equal')} | {(b.get('w3_check_against_reference') or {}).get('result', '')} |"
+        )
+    for variant in ("ops", "ops-naive", "ops-naive-closure", "sparse-missingdelete", "sparse-missingdelete-closure", "full-missingdelete"):
+        doc = load(V2 / scale / f"w2-{variant}.json")
+        for name, runs in by_batch(doc).items():
+            vis = med([x["visible_after_ms"] for x in runs])
+            direct = ref[name]["direct"]
+            r2 = ref[name]["round2_direct"]
+            recon = [x["reconcile"] for x in runs]
+            closure = [rc.get("closure") or {} for rc in recon]
+            checks = sorted({(x.get("w3_check_against_reference") or {}).get("result", "") for x in runs} - {""})
+            print(
+                f"| {variant} | {name} | {len(runs)} | {vis} | {round(vis / direct, 2) if direct and vis else 'n/a'} | "
+                f"{round(vis / r2, 2) if r2 and vis else 'n/a'} | {med([x['capture_ms']['p50_ms'] for x in runs])} | "
+                f"{med([rc['ms'] for rc in recon])} | {sorted({rc['quarantined'] for rc in recon})} | "
+                f"{sorted({rc.get('omittedMissing', 0) for rc in recon})} | "
+                f"{sorted({(c.get('removed'), c.get('moved')) for c in closure if c}) or '-'} | "
+                f"{sorted({x['dangling_edges_after_publish'] for x in runs})} | "
+                f"{sorted({(x['same_rows_as_one_writer_in_line_order'] or {}).get('equal') for x in runs})} | {'; '.join(checks)} |"
+            )
+    print("\nOne writer in line order (this run):\n")
+    print("| Batch | DirectStore visible ms (runs) | One operation envelope visible ms (reconcile ms) | Same rows | Round 2 DirectStore ms |")
+    print("| --- | --- | --- | --- | --- |")
+    for name, v in ref.items():
+        print(f"| {name} | {v['direct']} ({v['direct_n']}) | {v['append']} ({v['append_reconcile']}) | {v['same_rows']} | {v['round2_direct']} |")
+
+
+def trickle(scale: str) -> None:
+    cap = load(V2 / scale / "w2-trickle-capture.json")
+    base = load(BASE / scale / "w2-trickle.json")
+    print(f"\n## {scale}: trickle (H1, H5)\n")
+    if cap:
+        print("| Arm | Records | Runs | Capture p50 ms | Reconcile ms | Visible ms | Round 1 full-copy capture ms |")
+        print("| --- | --- | --- | --- | --- | --- | --- |")
+        for key, v in cap["batches"].items():
+            size = v["records"]
+            b = (base or {}).get("batches", {}).get(f"SnapshotStore.{size}", {})
+            print(f"| {v['arm']} | {size} | {v['reps']} | {v['capture_ms']} | {v['reconcile_ms']} | {v['visible_ms_median']} | {b.get('capture_ms')} |")
+    for strategy in ("ops", "sparse"):
+        s = (load(V2 / scale / f"w2-trickle-sustained-{strategy}.json") or {}).get("sustained")
+        if not s:
+            continue
+        print(
+            f"\nSustained, {strategy}: offered {s['offered_records_per_s']}/s, captured {s['records_captured']} "
+            f"({s['capture_records_per_s']}/s, capture p50 {s['capture_ms']['p50']} ms), published "
+            f"{s['records_published']} ({s['published_records_per_s']}/s) in {s['publishes']} publishes; "
+            f"cycle median {s['publish_cycle_ms']['median']} ms (build {s['build_ms_median']}, gc {s['gc_retain0_ms_median']}); "
+            f"visibility p50 {s['visibility_delay_ms']['p50']} ms, p95 {s['visibility_delay_ms']['p95']} ms, "
+            f"{s['visibility_delay_in_cycles']['p50']} and {s['visibility_delay_in_cycles']['p95']} cycles."
+        )
+    if base:
+        print(f"\nRound 1 sustained: {json.dumps(base['sustained'])}")
+
+
+def main() -> None:
+    scales = sys.argv[1:] or ["S1-r2", "S2-r2", "S1", "S2"]
+    for scale in scales:
+        if scale.endswith("-r2"):
+            four_writers(scale)
+        else:
+            trickle(scale)
+
+
+if __name__ == "__main__":
+    main()
